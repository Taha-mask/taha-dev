<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Taha Mahmoud — Web & Flutter Developer</title>
  <meta name="description" content="Web & Flutter Developer specializing in Angular, TypeScript, and Flutter. Building responsive web apps and cross-platform mobile experiences from Egypt.">
  <meta name="keywords" content="Taha Mahmoud, Web Developer, Flutter Developer, Angular, TypeScript, Supabase, Mobile Developer, Egypt, Assiut">
  <meta name="author" content="Taha Mahmoud">
  <meta property="og:title" content="Taha Mahmoud — Web & Flutter Developer">
  <meta property="og:description" content="Building responsive web apps and cross-platform Flutter experiences with Angular, TypeScript, and Supabase.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://taha-dev.vercel.app">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Taha Mahmoud — Web & Flutter Developer">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230d1117'/><text x='4' y='24' font-size='22' font-family='monospace' fill='%2339d353'>_</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <style>
/* ─── Reset & Tokens ─────────────────────────────────────────── */
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#0d1117;--bg2:#161b22;--bg3:#1c2128;
  --green:#39d353;--cyan:#58a6ff;--purple:#bc8cff;
  --orange:#ffa657;--red:#f85149;--muted:#8b949e;
  --border:#30363d;--white:#e6edf3;
  --glow-green:rgba(57,211,83,0.15);
  --glow-cyan:rgba(88,166,255,0.15);
  --radius:10px;
}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);color:var(--white);
  font-family:'Bricolage Grotesque',sans-serif;overflow-x:hidden;cursor:none;
}

/* ─── Noise texture overlay ──────────────────────────────────── */
body::before{
  content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
  opacity:0.025;
}

/* ─── Progress bar ───────────────────────────────────────────── */
#progress{position:fixed;top:0;left:0;height:2px;background:var(--green);width:0%;z-index:9999;transition:width 0.1s linear;box-shadow:0 0 8px var(--green);}

/* ─── Custom cursor ──────────────────────────────────────────── */
.cursor{position:fixed;width:8px;height:18px;background:var(--green);opacity:0.9;pointer-events:none;z-index:9998;transform:translate(-2px,-50%);animation:blink 1s steps(1) infinite;border-radius:1px;}
.cursor-ring{position:fixed;width:32px;height:32px;border:1px solid rgba(57,211,83,0.3);border-radius:50%;pointer-events:none;z-index:9997;transform:translate(-50%,-50%);transition:transform 0.08s ease,width 0.2s,height 0.2s,opacity 0.2s;}
@keyframes blink{0%,100%{opacity:.9;}50%{opacity:0;}}

/* ─── Nav ────────────────────────────────────────────────────── */
nav{
  position:sticky;top:0;z-index:200;
  background:rgba(13,17,23,0.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  padding:0 40px;height:58px;
  display:flex;align-items:center;justify-content:space-between;
}
.nav-brand{font-family:'Space Mono',monospace;font-size:14px;color:var(--green);user-select:none;}
.nav-brand span{color:var(--muted);}
.nav-links{display:flex;gap:0;list-style:none;}
.nav-links a{
  color:var(--muted);text-decoration:none;font-size:12px;
  padding:8px 14px;transition:color 0.2s;
  font-family:'Space Mono',monospace;cursor:none;
  position:relative;
}
.nav-links a::after{content:'';position:absolute;bottom:4px;left:14px;right:14px;height:1px;background:var(--cyan);transform:scaleX(0);transition:transform 0.2s;}
.nav-links a:hover{color:var(--cyan);}
.nav-links a:hover::after{transform:scaleX(1);}
.nav-status{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--muted);font-family:'Space Mono',monospace;}
.status-dot{width:7px;height:7px;background:var(--green);border-radius:50%;animation:pulse 2s infinite;box-shadow:0 0 6px var(--green);}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.5;transform:scale(0.8);}}

/* hamburger */
.hamburger{display:none;flex-direction:column;gap:5px;cursor:none;padding:4px;}
.hamburger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;transition:all 0.3s;}
.hamburger.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px);}
.hamburger.open span:nth-child(2){opacity:0;}
.hamburger.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px);}
.mobile-menu{display:none;position:fixed;top:58px;left:0;right:0;background:rgba(13,17,23,0.97);border-bottom:1px solid var(--border);z-index:199;padding:16px 40px;flex-direction:column;gap:0;}
.mobile-menu.open{display:flex;}
.mobile-menu a{color:var(--muted);text-decoration:none;font-family:'Space Mono',monospace;font-size:13px;padding:14px 0;border-bottom:1px solid var(--border);cursor:none;}
.mobile-menu a:last-child{border-bottom:none;}

/* ─── Hero ───────────────────────────────────────────────────── */
.hero{
  min-height:calc(100vh - 58px);display:flex;align-items:center;
  padding:0 40px;position:relative;overflow:hidden;
}
/* Dot grid background */
.hero::before{
  content:'';position:absolute;inset:0;
  background-image:radial-gradient(circle, rgba(48,54,61,0.6) 1px, transparent 1px);
  background-size:28px 28px;pointer-events:none;
}
/* Glow orbs */
.hero-orb{position:absolute;border-radius:50%;pointer-events:none;filter:blur(80px);}
.orb-1{width:400px;height:400px;background:rgba(57,211,83,0.06);right:-80px;top:10%;}
.orb-2{width:300px;height:300px;background:rgba(88,166,255,0.06);right:20%;bottom:10%;}

.hero-bg-code{
  position:absolute;right:0;top:0;bottom:0;width:50%;
  opacity:0.055;overflow:hidden;pointer-events:none;
  padding:60px 40px;font-family:'Space Mono',monospace;
  font-size:11.5px;line-height:1.9;color:var(--green);white-space:pre;
  -webkit-mask-image:linear-gradient(to right,transparent,rgba(0,0,0,0.7) 30%,rgba(0,0,0,0.7) 70%,transparent);
  mask-image:linear-gradient(to right,transparent,rgba(0,0,0,0.7) 30%,rgba(0,0,0,0.7) 70%,transparent);
}
.hero-content{display:flex;align-items:center;justify-content:space-between;width:100%;max-width:1100px;margin:0 auto;gap:40px;z-index:2;}
.hero-right{position:relative;z-index:2;flex-shrink:0;}
.hero-image-wrap{width:290px;height:380px;border-radius:24px;overflow:hidden;border:1px solid var(--border);position:relative;box-shadow:0 0 40px rgba(57,211,83,0.05);transform:rotate(3deg) translateY(0);transition:all 0.4s cubic-bezier(0.175,0.885,0.32,1.275);cursor:none;}
.hero-image-wrap:hover{transform:rotate(0deg) translateY(-8px);border-color:var(--green);box-shadow:0 12px 48px rgba(57,211,83,0.18);}
.hero-image{width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease, filter 0.4s ease;filter:contrast(105%) brightness(95%);}
.hero-image-wrap:hover .hero-image{transform:scale(1.05);filter:contrast(110%) brightness(105%);}
.hero-image-overlay{position:absolute;inset:0;background:linear-gradient(135deg,rgba(57,211,83,0.15) 0%,rgba(88,166,255,0.1) 100%);mix-blend-mode:overlay;pointer-events:none;transition:opacity 0.4s ease;}
.hero-image-wrap:hover .hero-image-overlay{opacity:0;}
.hero-left{max-width:580px;z-index:2;}
.hero-tag{
  font-family:'Space Mono',monospace;font-size:12px;color:var(--green);
  margin-bottom:20px;display:inline-flex;align-items:center;gap:10px;
  padding:6px 14px;background:var(--glow-green);border:1px solid rgba(57,211,83,0.2);border-radius:20px;
}
.tag-dot{width:6px;height:6px;background:var(--green);border-radius:50%;animation:pulse 2s infinite;}
.hero-name{font-size:clamp(44px,6vw,78px);font-weight:800;line-height:0.95;margin-bottom:10px;letter-spacing:-3px;}
.hero-name .first{color:var(--white);}
.hero-name .last{
  color:transparent;
  background:linear-gradient(135deg,var(--cyan) 0%,var(--purple) 100%);
  -webkit-background-clip:text;background-clip:text;
}
.hero-role{font-family:'Space Mono',monospace;font-size:15px;color:var(--muted);margin-bottom:24px;display:flex;align-items:center;gap:6px;}
.typed-text{color:var(--orange);}
.hero-desc{font-size:16px;color:var(--muted);line-height:1.75;max-width:460px;margin-bottom:36px;}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;}
.btn{
  padding:12px 24px;border-radius:8px;font-size:13px;font-weight:600;
  cursor:none;transition:all 0.25s;text-decoration:none;
  display:inline-flex;align-items:center;gap:8px;
  font-family:'Space Mono',monospace;border:none;
}
.btn-green{background:var(--green);color:#0d1117;box-shadow:0 0 20px rgba(57,211,83,0.2);}
.btn-green:hover{background:#4ae168;transform:translateY(-2px);box-shadow:0 4px 24px rgba(57,211,83,0.35);}
.btn-ghost{background:transparent;color:var(--white);border:1px solid var(--border);}
.btn-ghost:hover{border-color:var(--cyan);color:var(--cyan);transform:translateY(-2px);background:rgba(88,166,255,0.05);}
.hero-stats{display:flex;gap:36px;margin-top:48px;padding-top:32px;border-top:1px solid var(--border);}
.hero-stat .num{font-size:30px;font-weight:800;color:var(--white);}
.hero-stat .lbl{font-size:11px;color:var(--muted);margin-top:3px;font-family:'Space Mono',monospace;}

/* ─── Section base ───────────────────────────────────────────── */
section{padding:88px 40px;position:relative;z-index:1;}
.sec-header{margin-bottom:52px;}
.sec-tag{font-family:'Space Mono',monospace;font-size:11px;color:var(--green);letter-spacing:3px;text-transform:uppercase;margin-bottom:10px;}
.sec-title{font-size:clamp(28px,4vw,42px);font-weight:800;letter-spacing:-1.5px;}
.sec-sub{font-size:15px;color:var(--muted);margin-top:10px;max-width:480px;line-height:1.65;}

/* ─── Spec bar ───────────────────────────────────────────────── */
.spec-bar{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:20px 40px;display:flex;justify-content:center;}
.spec-item{display:flex;align-items:center;gap:12px;padding:0 40px;border-right:1px solid var(--border);}
.spec-item:last-child{border-right:none;}
.spec-icon{font-size:22px;}
.spec-label{font-family:'Space Mono',monospace;font-size:13px;color:var(--white);font-weight:600;}
.spec-sub{font-size:11px;color:var(--muted);font-family:'Space Mono',monospace;}

/* ─── Skills ─────────────────────────────────────────────────── */
.skills-section{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.skills-cols{display:grid;grid-template-columns:1fr 1fr;gap:48px;}
.skill-col-title{font-family:'Space Mono',monospace;font-size:13px;margin-bottom:20px;display:flex;align-items:center;gap:10px;color:var(--white);}
.skill-col-title .dot{width:10px;height:10px;border-radius:50%;}
.skill-list{display:flex;flex-direction:column;gap:14px;}
.skill-row{display:flex;align-items:center;gap:12px;}
.skill-name-txt{font-family:'Space Mono',monospace;font-size:13px;min-width:120px;}
.skill-bar-wrap{flex:1;height:4px;background:var(--bg3);border-radius:2px;overflow:hidden;}
.skill-bar-fill{height:100%;border-radius:2px;transition:width 1.4s cubic-bezier(0.4,0,0.2,1);}
.skill-pct{font-family:'Space Mono',monospace;font-size:11px;color:var(--muted);min-width:32px;text-align:right;}

/* ─── Projects ───────────────────────────────────────────────── */
.projects-section{background:var(--bg);}
.filter-bar{display:flex;gap:8px;margin-bottom:36px;flex-wrap:wrap;}
.filter-btn{
  padding:6px 16px;border-radius:20px;font-size:11px;
  font-family:'Space Mono',monospace;border:1px solid var(--border);
  background:transparent;color:var(--muted);cursor:none;transition:all 0.2s;
}
.filter-btn:hover,.filter-btn.active{border-color:var(--cyan);color:var(--cyan);background:rgba(88,166,255,0.07);}
.projects-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;}
.project-card{
  background:var(--bg2);border:1px solid var(--border);border-radius:12px;
  overflow:hidden;transition:border-color 0.25s,transform 0.25s,box-shadow 0.25s;
  cursor:none;display:flex;flex-direction:column;
}
.project-card:hover{border-color:var(--cyan);transform:translateY(-5px);box-shadow:0 8px 32px rgba(88,166,255,0.08);}
/* Card preview thumbnail */
.card-preview{height:120px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;}
.preview-web{background:linear-gradient(135deg,#0d1b2a,#1a3a5c);}
.preview-flutter{background:linear-gradient(135deg,#0d2137,#0a3d5e);}
.preview-tool{background:linear-gradient(135deg,#1a1a0d,#2e2a00);}
.preview-arabic{background:linear-gradient(135deg,#1a0d2e,#2d0055);}
.preview-screen{background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:10px 14px;font-family:'Space Mono',monospace;font-size:10px;color:var(--muted);min-width:180px;}
.preview-phone{width:56px;height:96px;background:var(--bg);border:2px solid var(--border);border-radius:12px;display:flex;flex-direction:column;padding:7px 5px;gap:5px;}
.preview-phone-top{height:4px;background:var(--cyan);border-radius:2px;opacity:0.7;}
.preview-phone-block{height:18px;background:var(--border);border-radius:3px;}
.card-type-badge{position:absolute;top:10px;right:10px;font-family:'Space Mono',monospace;font-size:10px;padding:3px 8px;border-radius:4px;}
.badge-web{background:rgba(88,166,255,0.15);color:var(--cyan);border:1px solid rgba(88,166,255,0.3);}
.badge-flutter{background:rgba(84,197,248,0.15);color:#54c5f8;border:1px solid rgba(84,197,248,0.3);}
.badge-tool{background:rgba(255,166,87,0.15);color:var(--orange);border:1px solid rgba(255,166,87,0.3);}
.card-header{padding:16px 18px 0;display:flex;justify-content:space-between;align-items:center;}
.card-icon{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;background:var(--bg3);}
.card-links{display:flex;gap:8px;}
.card-link{
  color:var(--muted);text-decoration:none;font-size:11px;
  font-family:'Space Mono',monospace;padding:4px 10px;
  border:1px solid var(--border);border-radius:4px;
  transition:all 0.2s;cursor:none;
}
.card-link:hover{color:var(--cyan);border-color:var(--cyan);}
.card-body{padding:12px 18px;flex:1;}
.card-title{font-size:15px;font-weight:700;margin-bottom:7px;}
.card-desc{font-size:13px;color:var(--muted);line-height:1.65;}
.card-footer{padding:12px 18px;border-top:1px solid var(--border);display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
.tech-tag{font-size:11px;font-family:'Space Mono',monospace;padding:3px 8px;border-radius:4px;background:var(--bg3);}
.tag-ts{color:#3178c6;}.tag-react{color:#61dafb;}.tag-angular{color:#dd0031;}
.tag-python{color:#ffd43b;}.tag-node{color:#68a063;}.tag-flutter{color:#54c5f8;}
.tag-dart{color:#0175c2;}.tag-asp{color:#512bd4;}.tag-sql{color:#f29111;}.tag-supabase{color:#3ecf8e;}
.tag-css{color:#264de4;}.tag-html{color:#e34c26;}.tag-js{color:#f7df1e;}
.tag-firebase{color:#ffca28;}.tag-ollama{color:#a855f7;}.tag-socketio{color:#010101;background:rgba(255,255,255,0.08);}
.tag-default{color:var(--muted);}
.card-status{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-family:'Space Mono',monospace;padding:3px 10px;border-radius:12px;margin-left:auto;}
.status-live{background:rgba(57,211,83,0.1);color:var(--green);border:1px solid rgba(57,211,83,0.2);}
.status-wip{background:rgba(255,166,87,0.1);color:var(--orange);border:1px solid rgba(255,166,87,0.2);}

/* ─── Terminal / About ───────────────────────────────────────── */
.terminal-section{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.terminal{
  background:var(--bg);border:1px solid var(--border);border-radius:12px;
  overflow:hidden;max-width:720px;margin:0 auto;
  box-shadow:0 8px 48px rgba(0,0,0,0.4);
}
.terminal-bar{
  background:var(--bg3);padding:12px 16px;
  display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border);
}
.t-dot{width:12px;height:12px;border-radius:50%;}
.t-red{background:#f85149;}.t-yellow{background:#e3b341;}.t-green{background:#3fb950;}
.t-title{font-family:'Space Mono',monospace;font-size:12px;color:var(--muted);margin:0 auto;}
.terminal-body{padding:28px;font-family:'Space Mono',monospace;font-size:13px;line-height:2;}
.t-prompt{color:var(--green);}.t-cmd{color:var(--white);}
.t-comment{color:var(--muted);}.t-key{color:var(--cyan);}
.t-val{color:var(--orange);}.t-str{color:var(--purple);}.t-num{color:var(--green);}

/* ─── Contributions ──────────────────────────────────────────── */
.contrib-wrap{margin-top:52px;max-width:720px;margin-left:auto;margin-right:auto;}
.contrib-label{text-align:center;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:3px;color:var(--green);text-transform:uppercase;margin-bottom:16px;}
.contrib-grid{display:grid;grid-template-columns:repeat(52,1fr);gap:3px;}
.contrib-cell{aspect-ratio:1;border-radius:2px;transition:transform 0.15s;}
.contrib-cell:hover{transform:scale(1.5);z-index:2;position:relative;}
.c0{background:#161b22;}.c1{background:#0e4429;}.c2{background:#006d32;}
.c3{background:#26a641;}.c4{background:#39d353;}
.contrib-legend{display:flex;align-items:center;gap:6px;justify-content:center;margin-top:10px;font-family:'Space Mono',monospace;font-size:11px;color:var(--muted);}
.legend-cell{width:11px;height:11px;border-radius:2px;}

/* ─── Contact ────────────────────────────────────────────────── */
.contact-section{background:var(--bg);}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;max-width:840px;}
.contact-info{display:flex;flex-direction:column;gap:14px;}
.contact-item{
  display:flex;align-items:center;gap:14px;padding:16px;
  background:var(--bg2);border:1px solid var(--border);border-radius:10px;
  transition:border-color 0.2s,box-shadow 0.2s;cursor:none;text-decoration:none;
}
.contact-item:hover{border-color:var(--cyan);box-shadow:0 4px 16px rgba(88,166,255,0.08);}
.ci-icon{font-size:15px;width:38px;height:38px;background:var(--bg3);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.ci-label{font-size:10px;color:var(--muted);font-family:'Space Mono',monospace;}
.ci-val{font-size:12px;font-weight:600;font-family:'Space Mono',monospace;color:var(--cyan);}
.contact-form{display:flex;flex-direction:column;gap:12px;}
.cf-input{
  background:var(--bg2);border:1px solid var(--border);border-radius:8px;
  padding:12px 14px;color:var(--white);font-size:13px;
  font-family:'Space Mono',monospace;outline:none;
  transition:border-color 0.2s,box-shadow 0.2s;resize:none;width:100%;
}
.cf-input:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(88,166,255,0.08);}
.cf-input::placeholder{color:var(--muted);}
.send-btn{
  background:var(--green);color:#0d1117;border:none;border-radius:8px;
  padding:14px;font-size:13px;font-weight:700;
  font-family:'Space Mono',monospace;cursor:none;transition:all 0.2s;
  box-shadow:0 0 20px rgba(57,211,83,0.2);
}
.send-btn:hover{background:#4ae168;transform:translateY(-2px);box-shadow:0 4px 24px rgba(57,211,83,0.35);}
.send-btn:disabled{opacity:0.6;transform:none;}

/* ─── Footer ─────────────────────────────────────────────────── */
footer{
  background:var(--bg2);border-top:1px solid var(--border);
  padding:36px 40px;display:flex;justify-content:space-between;
  align-items:center;flex-wrap:wrap;gap:16px;
}
.footer-brand{font-family:'Space Mono',monospace;font-size:13px;color:var(--green);}
.footer-copy{font-family:'Space Mono',monospace;font-size:11px;color:var(--muted);}
.footer-links{display:flex;gap:20px;}
.footer-links a{font-family:'Space Mono',monospace;font-size:11px;color:var(--muted);text-decoration:none;cursor:none;transition:color 0.2s;}
.footer-links a:hover{color:var(--cyan);}

/* ─── Animations ─────────────────────────────────────────────── */
.reveal{opacity:0;transform:translateY(24px);transition:opacity 0.65s ease,transform 0.65s ease;}
.reveal.on{opacity:1;transform:none;}

/* ─── Scrollbar ──────────────────────────────────────────────── */
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}
::-webkit-scrollbar-thumb:hover{background:var(--muted);}

/* ─── Responsive ─────────────────────────────────────────────── */
@media(max-width:900px){
  .contact-grid{grid-template-columns:1fr;}
  .hero-content{flex-direction:column;text-align:center;justify-content:center;gap:40px;margin-top:20px;}
  .hero-left{display:flex;flex-direction:column;align-items:center;}
  .hero-desc{text-align:center;}
  .hero-btns{justify-content:center;}
  .hero-stats{justify-content:center;flex-wrap:wrap;}
}
@media(max-width:640px){
  nav{padding:0 16px;}
  .nav-links{display:none;}
  .hamburger{display:flex;}
  .hero{padding:40px 16px;}
  .hero-stats{gap:24px;}
  .hero-stat .num{font-size:24px;}
  section{padding:64px 16px;}
  .skills-cols{grid-template-columns:1fr;}
  .spec-bar{flex-wrap:wrap;padding:0;}
  .spec-item{border-right:none;border-bottom:1px solid var(--border);padding:16px 20px;width:100%;}
  .contact-grid{grid-template-columns:1fr;}
  footer{padding:24px 16px;flex-direction:column;text-align:center;}
  .mobile-menu{padding:16px;}
  .contrib-grid{grid-template-columns:repeat(26,1fr);}
}
  </style>
</head>
<body>

<!-- Progress bar -->
<div id="progress"></div>

<!-- Custom cursor -->
<div class="cursor" id="cur"></div>
<div class="cursor-ring" id="ring"></div>

<!-- ─── Nav ───────────────────────────────────────────────────── -->
<nav>
  <div class="nav-brand">&lt;<span>taha</span>.dev /&gt;</div>
  <ul class="nav-links">
    <li><a href="#projects">projects</a></li>
    <li><a href="#skills">skills</a></li>
    <li><a href="#about">about</a></li>
    <li><a href="#contact">contact</a></li>
  </ul>
  <div style="display:flex;align-items:center;gap:20px;">
    <div class="nav-status">
      <div class="status-dot"></div>
      available for work
    </div>
    <div class="hamburger" id="ham" onclick="toggleMenu()">
      <span></span><span></span><span></span>
    </div>
  </div>
</nav>
<div class="mobile-menu" id="mobileMenu">
  <a href="#projects" onclick="closeMenu()">projects</a>
  <a href="#skills" onclick="closeMenu()">skills</a>
  <a href="#about" onclick="closeMenu()">about</a>
  <a href="#contact" onclick="closeMenu()">contact</a>
</div>

<!-- ─── Hero ──────────────────────────────────────────────────── -->
<div class="hero">
  <div class="hero-orb orb-1"></div>
  <div class="hero-orb orb-2"></div>
  <div class="hero-bg-code" id="bgCode"></div>
  <div class="hero-content">
    <div class="hero-left">
    <div class="hero-tag">
      <span class="tag-dot"></span>
      Web & Flutter Developer — Egypt 🇪🇬
    </div>
    <div class="hero-name">
      <div class="first">Taha</div>
      <div class="last">Mahmoud.</div>
    </div>
    <div class="hero-role">
      <span style="color:var(--green);">$</span>
      <span class="typed-text" id="typed"></span><span style="color:var(--green);animation:blink 1s steps(1) infinite;">_</span>
    </div>
    <p class="hero-desc">I build fast, scalable web &amp; mobile applications. Focused on clean architecture, great UX, and code that actually ships.</p>
    <div class="hero-btns">
      <a href="#projects" class="btn btn-green">View Projects →</a>
      <a href="#contact" class="btn btn-ghost">Let's Talk</a>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><div class="num">10+</div><div class="lbl">// projects</div></div>
      <div class="hero-stat"><div class="num">3+</div><div class="lbl">// years exp</div></div>
      <div class="hero-stat"><div class="num">5+</div><div class="lbl">// happy clients</div></div>
    </div>
  </div>
  <div class="hero-right reveal on">
    <div class="hero-image-wrap">
      <img src="profile.jpg" alt="Taha Mahmoud" class="hero-image">
      <div class="hero-image-overlay"></div>
    </div>
  </div>
</div>
</div>

<!-- ─── Spec bar ─────────────────────────────────────────────── -->
<div class="spec-bar">
  <div class="spec-item">
    <div class="spec-icon">🌐</div>
    <div><div class="spec-label">Web Development</div><div class="spec-sub">Angular · TypeScript · HTML/CSS · JS</div></div>
  </div>
  <div class="spec-item">
    <div class="spec-icon">📱</div>
    <div><div class="spec-label">Flutter Development</div><div class="spec-sub">Dart · Cross-Platform · Material UI</div></div>
  </div>
  <div class="spec-item">
    <div class="spec-icon">🗄️</div>
    <div><div class="spec-label">Backend & DB</div><div class="spec-sub">Supabase · SQL · REST APIs</div></div>
  </div>
</div>

<!-- ─── Skills ─────────────────────────────────────────────────── -->
<section class="skills-section" id="skills">
  <div class="sec-header reveal">
    <div class="sec-tag">// tech stack</div>
    <h2 class="sec-title">Skills & Tools</h2>
    <p class="sec-sub">Two specialties, one developer — web and Flutter backed by a solid foundation.</p>
  </div>
  <div class="skills-cols">
    <div class="reveal">
      <div class="skill-col-title"><div class="dot" style="background:var(--cyan)"></div>Web Development</div>
      <div class="skill-list" id="webSkills"></div>
    </div>
    <div class="reveal">
      <div class="skill-col-title"><div class="dot" style="background:#54c5f8"></div>Flutter & Mobile</div>
      <div class="skill-list" id="flutterSkills"></div>
    </div>
  </div>
</section>

<!-- ─── Projects ───────────────────────────────────────────────── -->
<section class="projects-section" id="projects">
  <div class="sec-header reveal">
    <div class="sec-tag">// work</div>
    <h2 class="sec-title">Featured Projects</h2>
    <p class="sec-sub">A selection of projects I've built — from freelance work to personal experiments.</p>
  </div>
  <div class="filter-bar">
    <button class="filter-btn active" onclick="filterProjects('all',this)">all</button>
    <button class="filter-btn" onclick="filterProjects('web',this)">web</button>
    <button class="filter-btn" onclick="filterProjects('flutter',this)">flutter</button>
    <button class="filter-btn" onclick="filterProjects('freelance',this)">freelance</button>
  </div>
  <div class="projects-grid" id="projectsGrid"></div>
</section>

<!-- ─── About / Terminal ────────────────────────────────────────── -->
<section class="terminal-section" id="about">
  <div class="sec-header reveal" style="text-align:center;">
    <div class="sec-tag" style="text-align:center;">// about</div>
    <h2 class="sec-title">Who am I?</h2>
  </div>
  <div class="terminal reveal">
    <div class="terminal-bar">
      <div class="t-dot t-red"></div>
      <div class="t-dot t-yellow"></div>
      <div class="t-dot t-green"></div>
      <div class="t-title">~ about.json</div>
    </div>
    <div class="terminal-body">
      <div><span class="t-prompt">❯ </span><span class="t-cmd">cat about.json</span></div>
      <div style="margin-top:14px;">{</div>
      <div>&nbsp;&nbsp;<span class="t-key">"name"</span>: <span class="t-str">"Taha Mahmoud"</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"age"</span>: <span class="t-num">19</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"role"</span>: <span class="t-str">"Web &amp; Flutter Developer"</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"university"</span>: <span class="t-str">"AITU — Assiut, Egypt"</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"currently_building"</span>: <span class="t-str">"BaladUp — Community Flutter App"</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"web_stack"</span>: [<span class="t-str">"Angular"</span>, <span class="t-str">"TypeScript"</span>, <span class="t-str">"Supabase"</span>],</div>
      <div>&nbsp;&nbsp;<span class="t-key">"mobile_stack"</span>: [<span class="t-str">"Flutter"</span>, <span class="t-str">"Dart"</span>, <span class="t-str">"Supabase"</span>],</div>
      <div>&nbsp;&nbsp;<span class="t-key">"interests"</span>: [<span class="t-str">"algorithms"</span>, <span class="t-str">"automation"</span>, <span class="t-str">"content creation"</span>],</div>
      <div>&nbsp;&nbsp;<span class="t-key">"open_to_work"</span>: <span class="t-num" style="color:var(--green)">true</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"email"</span>: <span class="t-str">"taha.mahmoud.eng@gmail.com"</span></div>
      <div>}</div>
      <div style="margin-top:14px;"><span class="t-prompt">❯ </span><span class="t-comment"># Always learning, always shipping 🚀</span></div>
    </div>
  </div>

  <div class="contrib-wrap">
    <div class="contrib-label reveal">// github activity</div>
    <div class="contrib-grid reveal" id="contribGrid"></div>
    <div class="contrib-legend reveal">
      <span>Less</span>
      <div class="legend-cell c0"></div>
      <div class="legend-cell c1"></div>
      <div class="legend-cell c2"></div>
      <div class="legend-cell c3"></div>
      <div class="legend-cell c4"></div>
      <span>More</span>
    </div>
  </div>
</section>

<!-- ─── Contact ─────────────────────────────────────────────────── -->
<section class="contact-section" id="contact">
  <div class="sec-header reveal">
    <div class="sec-tag">// contact</div>
    <h2 class="sec-title">Let's Build Together</h2>
    <p class="sec-sub">Have a project in mind? I'm open to freelance work, collaborations, and full-time opportunities.</p>
  </div>
  <div class="contact-grid">
    <div class="contact-info reveal">
      <a class="contact-item" href="mailto:taha.mahmoud.eng@gmail.com">
        <div class="ci-icon">✉</div>
        <div><div class="ci-label">email</div><div class="ci-val">taha.mahmoud.eng@gmail.com</div></div>
      </a>
      <a class="contact-item" href="https://github.com/Taha-mask" target="_blank" rel="noopener">
        <div class="ci-icon" style="font-size:13px;">⌘</div>
        <div><div class="ci-label">github</div><div class="ci-val">github.com/Taha-mask</div></div>
      </a>
      <a class="contact-item" href="https://www.linkedin.com/in/taha-mahmoud-8b6914269?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app" target="_blank" rel="noopener">
        <div class="ci-icon" style="font-size:13px;">in</div>
        <div><div class="ci-label">linkedin</div><div class="ci-val">linkedin.com/in/taha-mahmoud-8b6914269</div></div>
      </a>
      <div class="contact-item">
        <div class="ci-icon">📍</div>
        <div><div class="ci-label">location</div><div class="ci-val">Assiut, Egypt — GMT+3</div></div>
      </div>
    </div>
    <form class="contact-form reveal" id="contactForm" onsubmit="sendMsg(event)">
      <input class="cf-input" type="text" name="name" placeholder="your_name" required />
      <input class="cf-input" type="email" name="email" placeholder="your@email.com" required />
      <select class="cf-input" name="project" style="cursor:none;">
        <option value="" disabled selected style="background:#161b22;">project_type</option>
        <option style="background:#161b22;">Web App</option>
        <option style="background:#161b22;">Flutter App</option>
        <option style="background:#161b22;">Web + Flutter</option>
        <option style="background:#161b22;">Other</option>
      </select>
      <textarea class="cf-input" name="message" rows="5" placeholder="// tell me about your project..." required></textarea>
      <button class="send-btn" type="submit" id="sendBtn">$ send_message()</button>
    </form>
  </div>
</section>

<!-- ─── Footer ──────────────────────────────────────────────────── -->
<footer>
  <div class="footer-brand">&lt;taha.dev /&gt;</div>
  <div class="footer-copy">// crafted with ♥ — 2025</div>
  <div class="footer-links">
    <a href="https://github.com/Taha-mask" target="_blank" rel="noopener">GitHub</a>
    <a href="https://www.linkedin.com/in/taha-mahmoud-8b6914269?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app" target="_blank" rel="noopener">LinkedIn</a>
    <a href="mailto:taha.mahmoud.eng@gmail.com">Email</a>
  </div>
</footer>

<script>
/* ── Scroll progress ── */
window.addEventListener('scroll',()=>{
  const h=document.documentElement;
  const pct=(h.scrollTop/(h.scrollHeight-h.clientHeight))*100;
  document.getElementById('progress').style.width=pct+'%';
});

/* ── Cursor ── */
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{
  mx=e.clientX;my=e.clientY;
  document.getElementById('cur').style.cssText=`left:${mx}px;top:${my}px;`;
});
(function animRing(){
  rx+=(mx-rx)*0.12;ry+=(my-ry)*0.12;
  document.getElementById('ring').style.cssText=`left:${rx}px;top:${ry}px;`;
  requestAnimationFrame(animRing);
})();
document.querySelectorAll('a,button,.skill-chip,.project-card,.contact-item,.filter-btn').forEach(el=>{
  el.addEventListener('mouseenter',()=>{
    const r=document.getElementById('ring');
    r.style.width='48px';r.style.height='48px';r.style.borderColor='rgba(57,211,83,0.5)';
  });
  el.addEventListener('mouseleave',()=>{
    const r=document.getElementById('ring');
    r.style.width='32px';r.style.height='32px';r.style.borderColor='rgba(57,211,83,0.3)';
  });
});

/* ── Mobile menu ── */
function toggleMenu(){
  document.getElementById('ham').classList.toggle('open');
  document.getElementById('mobileMenu').classList.toggle('open');
}
function closeMenu(){
  document.getElementById('ham').classList.remove('open');
  document.getElementById('mobileMenu').classList.remove('open');
}

/* ── Typewriter ── */
const roles=['Web Developer','Angular Specialist','Flutter Developer','UI/UX Focused Dev','Freelance Developer'];
let ri=0,ci=0,del=false;
const tel=document.getElementById('typed');
function typeIt(){
  const r=roles[ri];
  if(!del){
    tel.textContent=r.slice(0,++ci);
    if(ci===r.length){del=true;setTimeout(typeIt,1900);return;}
  }else{
    tel.textContent=r.slice(0,--ci);
    if(ci===0){del=false;ri=(ri+1)%roles.length;}
  }
  setTimeout(typeIt,del?45:75);
}
typeIt();

/* ── Background code ── */
document.getElementById('bgCode').textContent=`import { Component, OnInit } from '@angular/core';
import { ProductService } from './product.service';

@Component({ selector: 'app-root', template: '...' })
export class AppComponent implements OnInit {
  products: Product[] = [];

  constructor(private svc: ProductService) {}

  ngOnInit() {
    this.svc.getAll().subscribe(p => this.products = p);
  }
}

// Supabase real-time subscription
const channel = supabase
  .channel('products')
  .on('postgres_changes', {
    event: '*', schema: 'public'
  }, payload => console.log(payload))
  .subscribe();

// Flutter Widget
Widget build(BuildContext ctx) => Scaffold(
  body: StreamBuilder<List<Order>>(
    stream: supabase.from('orders').stream(
      primaryKey: ['id']
    ),
    builder: (ctx, snap) => OrderList(snap.data ?? []),
  ),
);`;

/* ── Skills ── */
const webSkills=[
  {n:'HTML / CSS',pct:95,c:'#e34c26'},{n:'JavaScript',pct:88,c:'#f7df1e'},
  {n:'Angular',pct:85,c:'#dd0031'},{n:'TypeScript',pct:82,c:'#3178c6'},
  {n:'Bootstrap',pct:90,c:'#7952b3'},{n:'REST APIs',pct:80,c:'#39d353'},
  {n:'Supabase',pct:78,c:'#3ecf8e'},
];
const flutterSkills=[
  {n:'Flutter',pct:85,c:'#54c5f8'},{n:'Dart',pct:83,c:'#0175c2'},
  {n:'Material UI',pct:88,c:'#54c5f8'},{n:'Supabase',pct:78,c:'#3ecf8e'},
  {n:'State Mgmt',pct:75,c:'#bc8cff'},{n:'Firebase',pct:65,c:'#ffca28'},
  {n:'SQL',pct:72,c:'#f29111'},
];
function renderSkills(list,id){
  const el=document.getElementById(id);
  list.forEach(s=>{
    const row=document.createElement('div');
    row.className='skill-row';
    row.innerHTML=`<span class="skill-name-txt" style="color:${s.c}">${s.n}</span><div class="skill-bar-wrap"><div class="skill-bar-fill" style="width:0%;background:${s.c}" data-w="${s.pct}"></div></div><span class="skill-pct">${s.pct}%</span>`;
    el.appendChild(row);
  });
}
renderSkills(webSkills,'webSkills');
renderSkills(flutterSkills,'flutterSkills');
setTimeout(()=>document.querySelectorAll('.skill-bar-fill').forEach(b=>b.style.width=b.dataset.w+'%'),600);

/* ── Projects ── */
const projects=[
  /* ── GitHub projects ── */
  {title:'Flick',
   desc:'Flutter movie discovery app with a clean multi-screen architecture — reusable card widgets, smooth page transitions, and responsive Material Design layouts built to sharpen mobile UI craft.',
   tags:['flutter','dart'],cat:'flutter',status:'live',preview:'flutter',icon:'🎬',
   gh:'https://github.com/Taha-mask/flick',live:null},

  {title:'My Assistant',
   desc:'Always-on Windows voice assistant powered by a local Ollama LLM — handles app launching, volume/brightness, system lock/restart, weather, and hardware stats. Runs on startup with persistent conversation memory and proactive battery/time alerts, zero cloud required.',
   tags:['python','ollama'],cat:'web',status:'live',preview:'tool',icon:'🤖',
   gh:'https://github.com/Taha-mask/my_assistant',live:null},

  {title:'Ramadan Planner',
   desc:'Comprehensive Flutter lifestyle app for Ramadan: worship & prayer tracking, Quran study log, daily task manager, and self-assessment stats — bilingual Arabic/English UI, SQLite persistence, and a multi-Provider architecture with dedicated providers per domain.',
   tags:['flutter','dart','sqlite'],cat:'flutter',status:'live',preview:'flutter',icon:'🌙',
   gh:'https://github.com/Taha-mask/Ramadan_planner',live:null},

  {title:'Pomodoro Timer',
   desc:'Flutter focus timer using Cubit state management and dependency injection — distinct dynamic themes for work vs. break sessions, SQLite-backed session history, and a clean separation of presentation, business logic, and data layers.',
   tags:['flutter','dart','sqlite'],cat:'flutter',status:'live',preview:'flutter',icon:'🍅',
   gh:'https://github.com/Taha-mask/Pomodoro',live:null},

  {title:'Encryption Platform',
   desc:'Full-stack cryptography toolkit: 15+ algorithms (Caesar → AES/SHA-256) for encrypting and decrypting text, plus a real-time encrypted chat built on Socket.IO where each message can use a different cipher. Bilingual UI with step-by-step educational modals per algorithm.',
   tags:['node','js','socketio'],cat:'web',status:'live',preview:'tool',icon:'🔐',
   gh:'https://github.com/Taha-mask/Encryption',live:null},

  /* ── Freelance projects ── */
  {title:'Patarif Platform',
   desc:'Full-stack freelance marketplace built with Angular + Supabase — user authentication, seller dashboard, real-time data subscriptions, and a clean component architecture. Delivered to a real client and currently live.',
   tags:['angular','ts','supabase'],cat:'freelance fullstack web',status:'live',preview:'web',icon:'🧩',
   gh:null,live:null},

  {title:'Lawyer Assistant System',
   desc:'Web-based case management desk for a law firm — tracks clients, cases, and documents in a structured dashboard. Built with vanilla JavaScript and delivered as a standalone freelance project.',
   tags:['js','html'],cat:'freelance web',status:'live',preview:'web',icon:'⚖️',
   gh:null,live:null},

  {title:'BaladUp Community App',
   desc:'Flutter community platform for local neighborhoods — residents post updates, discover local events, and browse nearby services. Supabase handles auth and real-time data sync across devices.',
   tags:['flutter','dart','supabase'],cat:'freelance flutter',status:'wip',preview:'flutter',icon:'🏘️',
   gh:null,live:null},

  /* ── Personal & other projects ── */
];

const tagClass={
  angular:'tag-angular',asp:'tag-asp',supabase:'tag-supabase',ts:'tag-ts',
  flutter:'tag-flutter',dart:'tag-dart',python:'tag-python',node:'tag-node',
  sql:'tag-sql',sqlite:'tag-sql',html:'tag-html',js:'tag-js',
  ollama:'tag-ollama',socketio:'tag-socketio',
};
const tagLabel={
  angular:'Angular',asp:'ASP.NET',supabase:'Supabase',ts:'TypeScript',
  flutter:'Flutter',dart:'Dart',python:'Python',node:'Node.js',
  sql:'SQL',sqlite:'SQLite',html:'HTML/CSS',js:'JavaScript',
  ollama:'Ollama LLM',socketio:'Socket.IO',
};

function previewHTML(type){
  if(type==='flutter')return`<div class="card-preview preview-flutter"><div class="preview-phone"><div class="preview-phone-top"></div><div class="preview-phone-block"></div><div class="preview-phone-block" style="opacity:.5;margin-top:4px;"></div><div class="preview-phone-block" style="opacity:.3;margin-top:4px;"></div></div><span class="card-type-badge badge-flutter">Flutter</span></div>`;
  if(type==='tool')return`<div class="card-preview preview-tool"><div class="preview-screen"><span style="color:var(--orange);">$ run script.js</span><br><span style="color:var(--green);">✓ output generated<br>✓ Done in 0.3s</span></div><span class="card-type-badge badge-tool">Tool</span></div>`;
  if(type==='arabic')return`<div class="card-preview preview-arabic"><div class="preview-screen" style="text-align:right;direction:rtl;"><span style="color:var(--purple);font-size:12px;">مراكزنا</span><br><span style="color:var(--muted);font-size:10px;">اختر مركزك القريب</span></div><span class="card-type-badge badge-web">Web</span></div>`;
  return`<div class="card-preview preview-web"><div class="preview-screen"><span style="color:var(--green);">GET</span> /api/products<br><span style="color:var(--cyan);">200</span> OK · 42ms<br><span style="color:var(--muted);">[ { id:1, ... } ]</span></div><span class="card-type-badge badge-web">Web</span></div>`;
}

function renderProjects(filter){
  const grid=document.getElementById('projectsGrid');
  grid.innerHTML='';
  projects.filter(p=>filter==='all'||p.cat.includes(filter)).forEach(p=>{
    const c=document.createElement('div');
    c.className='project-card reveal';
    const ghBtn=p.gh
      ?`<a href="${p.gh}" target="_blank" rel="noopener" class="card-link">GitHub ↗</a>`
      :`<span class="card-link" style="color:var(--muted);border-color:var(--border);cursor:default;">🔒 Private</span>`;
    const links=`<div class="card-links">
      ${ghBtn}
      ${p.live?`<a href="${p.live}" target="_blank" rel="noopener" class="card-link" style="color:var(--green);border-color:rgba(57,211,83,0.3)">Live ↗</a>`:''}
    </div>`;
    const tags=p.tags.map(t=>`<span class="tech-tag ${tagClass[t]||'tag-default'}">${tagLabel[t]||t}</span>`).join('');
    const statusHtml=p.status==='live'
      ?`<span class="card-status status-live">● live</span>`
      :`<span class="card-status status-wip">◌ in progress</span>`;
    c.innerHTML=`
      ${previewHTML(p.preview||'web')}
      <div class="card-header"><div class="card-icon">${p.icon}</div>${links}</div>
      <div class="card-body">
        <div class="card-title">${p.title}</div>
        <div class="card-desc">${p.desc}</div>
      </div>
      <div class="card-footer">${tags}${statusHtml}</div>`;
    grid.appendChild(c);
    obs.observe(c);
  });
}

function filterProjects(f,btn){
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderProjects(f);
}

/* ── Contributions ── */
const cg=document.getElementById('contribGrid');
for(let i=0;i<364;i++){
  const d=document.createElement('div');
  const r=Math.random();
  d.className='contrib-cell '+(r<0.42?'c0':r<0.6?'c1':r<0.75?'c2':r<0.9?'c3':'c4');
  cg.appendChild(d);
}

/* ── Intersection observer ── */
const obs=new IntersectionObserver(es=>{
  es.forEach((e,i)=>{
    if(e.isIntersecting) setTimeout(()=>e.target.classList.add('on'),i*45);
  });
},{threshold:0.08,rootMargin:'0px 0px -24px 0px'});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
renderProjects('all');

/* ── Contact form (mailto fallback) ── */
function sendMsg(e){
  e.preventDefault();
  const btn=document.getElementById('sendBtn');
  const form=e.target;
  const name=form.querySelector('[name=name]').value;
  const email=form.querySelector('[name=email]').value;
  const project=form.querySelector('[name=project]').value;
  const message=form.querySelector('[name=message]').value;

  btn.textContent='sending...';
  btn.disabled=true;

  const subject=encodeURIComponent(`Portfolio Contact from ${name}`);
  const body=encodeURIComponent(`Name: ${name}\nEmail: ${email}\nProject: ${project}\n\nMessage:\n${message}`);
  window.location.href=`mailto:taha.mahmoud.eng@gmail.com?subject=${subject}&body=${body}`;

  setTimeout(()=>{
    btn.textContent='✓ message_sent()';
    btn.style.background='#26a641';
    setTimeout(()=>{
      btn.textContent='$ send_message()';
      btn.style.background='';
      btn.disabled=false;
      form.reset();
    },3000);
  },800);
}

/* ── Smooth scroll ── */
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    const t=document.querySelector(a.getAttribute('href'));
    if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'});}
  });
});
</script>
</body>
</html>
