---
import '../styles/global.css';
import { getBasePath, getLangFromUrl, getLocalePath, useTranslations } from '../i18n/utils';

export interface Props {
	title?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();
const title = Astro.props.title || t.layout.title;

// Absolute URLs for this page in every locale. Search engines need each
// translation to point at all of them (itself included) before they treat the
// pages as translations rather than duplicates.
const site = Astro.site ?? new URL(Astro.url.origin);
const basePath = getBasePath(Astro.url);
const enUrl = new URL(getLocalePath('en', basePath), site).href;
const arUrl = new URL(getLocalePath('ar', basePath), site).href;
const canonicalUrl = lang === 'ar' ? arUrl : enUrl;
---

<!DOCTYPE html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0f0f0f" id="themeColor">

  <!-- Theme bootstrap. is:inline keeps this out of Astro's bundle so it runs
       synchronously in <head>, BEFORE the first paint — otherwise a visitor who
       picked light would get a flash of the dark palette on every page load.
       Stored choice wins; with no stored choice we follow the OS setting. -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) { /* private mode */ }
      var theme = (stored === 'light' || stored === 'dark')
        ? stored
        : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);

      // Tells the stylesheet that JavaScript is running, which is the only
      // condition under which the scroll-reveal is allowed to hide anything.
      document.documentElement.classList.add('js');

      // Keep the mobile browser chrome in step with the page background.
      var meta = document.getElementById('themeColor');
      if (meta) meta.setAttribute('content', theme === 'light' ? '#fbfbfb' : '#0f0f0f');
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={t.layout.description}>
  <meta name="keywords" content={t.layout.keywords}>
  <meta name="author" content="Taha Mahmoud">
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" hreflang="en" href={enUrl}>
  <link rel="alternate" hreflang="ar" href={arUrl}>
  <!-- Which version a visitor with no matching language should land on. -->
  <link rel="alternate" hreflang="x-default" href={enUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={t.layout.description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content={lang === 'ar' ? 'ar_EG' : 'en_US'}>
  <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_EG'}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <!-- Tab icon. The .ico covers the bare /favicon.ico request browsers make on
       their own (and older ones that ignore the tags); the PNGs are what every
       current browser picks once it has read the markup. -->
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Three Latin families and one Arabic, in a single request. Source Serif
       carries the headings, Inter everything that gets read, JetBrains Mono
       the small print — and IBM Plex Sans Arabic every Arabic glyph on the
       site, since none of the other three cover the script. Weights are
       deliberately few: 400 and 500/600 are the whole hierarchy. -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <slot />

  <script>
    /* ── Reveal on scroll ──
       The site's only scroll-driven effect: a section fades the last 10px
       into place once, then the observer forgets about it. No parallax, no
       scroll hijacking, nothing that keeps running while you read.
       prefers-reduced-motion is handled in CSS, which leaves .reveal fully
       visible — so this still runs, it just has nothing to animate. */
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('on');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    const watchReveals = () => {
      document.querySelectorAll('.reveal:not(.on)').forEach(el => revealObserver.observe(el));
    };

    /* Safety net. The hidden state only lifts when the observer delivers, and
       an observer that never delivers — a tab the browser is not painting, an
       extension, a bug — would leave the page blank. Sweeping on load and once
       more shortly after means anything already on screen shows up regardless. */
    const sweepReveals = () => {
      document.querySelectorAll('.reveal:not(.on)').forEach(el => {
        if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('on');
      });
    };

    watchReveals();
    window.addEventListener('load', sweepReveals);
    window.setTimeout(sweepReveals, 1200);
    // Support Astro view transitions if they are ever switched on.
    document.addEventListener('astro:page-load', watchReveals);
  </script>
</body>
</html>
