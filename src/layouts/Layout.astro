---
import '../styles/global.css';
export interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content="Web & Flutter Developer specializing in Angular, TypeScript, and Flutter. Building responsive web apps and cross-platform mobile experiences from Egypt.">
  <meta name="keywords" content="Taha Mahmoud, Web Developer, Flutter Developer, Angular, TypeScript, Supabase, Mobile Developer, Egypt, Assiut">
  <meta name="author" content="Taha Mahmoud">
  <meta property="og:title" content="Taha Mahmoud — Web & Flutter Developer">
  <meta property="og:description" content="Building responsive web apps and cross-platform Flutter experiences with Angular, TypeScript, and Supabase.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://taha-dev.vercel.app">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Taha Mahmoud — Web & Flutter Developer">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
  <style>
    /* ─── Progress bar ───────────────────────────────────────────── */
    #progress{position:fixed;top:0;left:0;height:2px;background:var(--green);width:0%;z-index:9999;transition:width 0.1s linear;box-shadow:0 0 8px var(--green);}

    /* ─── Custom cursor ──────────────────────────────────────────── */
    .cursor{position:fixed;top:0;left:0;width:8px;height:18px;background:var(--green);opacity:0.9;pointer-events:none;z-index:9998;animation:blink 1s steps(1) infinite;border-radius:1px;will-change:transform;}
    .cursor-ring{position:fixed;top:0;left:0;width:32px;height:32px;border:1px solid rgba(57,211,83,0.3);border-radius:50%;pointer-events:none;z-index:9997;transition:width 0.15s ease-out,height 0.15s ease-out,border-color 0.15s ease-out;will-change:transform;}
  </style>
</head>
<body>
  <div id="progress"></div>
  <div class="cursor" id="cur"></div>
  <div class="cursor-ring" id="ring"></div>

  <slot />

  <script>
    /* ── Scroll progress ── */
    window.addEventListener('scroll', () => {
      const h = document.documentElement;
      const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
      const prog = document.getElementById('progress');
      if (prog) prog.style.width = pct + '%';
    });

    /* ── Cursor ──
       cursor:none is set all over global.css assuming this custom cursor is
       running. On touch devices, with prefers-reduced-motion, or if this
       script never gets this far, that would leave visitors with no cursor
       at all — so only commit to hiding the native one once we know a fine
       pointer is present and motion is allowed. */
    const cur = document.getElementById('cur');
    const ring = document.getElementById('ring');
    const canUseCustomCursor =
      window.matchMedia('(pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canUseCustomCursor) {
      document.documentElement.classList.add('has-custom-cursor');
      document.addEventListener('mousemove', e => {
        if (cur) cur.style.transform = `translate3d(calc(${e.clientX}px - 2px), calc(${e.clientY}px - 50%), 0)`;
        if (ring) ring.style.transform = `translate3d(calc(${e.clientX}px - 50%), calc(${e.clientY}px - 50%), 0)`;
      }, { passive: true });
    }

    // Reveal animations
    const obs = new IntersectionObserver(es => {
      es.forEach((e, i) => {
        if (e.isIntersecting) setTimeout(() => e.target.classList.add('on'), i * 45);
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

    // Add cursor hover effect to elements
    const addCursorHover = () => {
      if (!canUseCustomCursor) return;
      document.querySelectorAll('a,button,.skill-chip,.project-card,.contact-item,.filter-btn').forEach(el => {
        el.addEventListener('mouseenter', () => {
          const r = document.getElementById('ring');
          if (r) { r.style.width = '48px'; r.style.height = '48px'; r.style.borderColor = 'rgba(57,211,83,0.5)'; }
        });
        el.addEventListener('mouseleave', () => {
          const r = document.getElementById('ring');
          if (r) { r.style.width = '32px'; r.style.height = '32px'; r.style.borderColor = 'rgba(57,211,83,0.3)'; }
        });
      });
    };

    // Run on initial load
    addCursorHover();
    
    // Support Astro view transitions if they are used
    document.addEventListener('astro:page-load', () => {
      addCursorHover();
      document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
    });
  </script>

  <!-- Smooth Scroll (Lenis) -->
  <script src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  <script>
    // Lenis re-times every scroll with inertia — exactly the kind of motion
    // prefers-reduced-motion asks sites to skip. Leave native (instant) scroll
    // in place for those users instead of smoothing it.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        direction: 'vertical',
        gestureDirection: 'vertical',
        smooth: true,
        mouseMultiplier: 1,
        smoothTouch: false,
        touchMultiplier: 2,
        infinite: false,
      });

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    }
  </script>
</body>
</html>
