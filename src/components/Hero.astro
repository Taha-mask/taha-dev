---
---
<div class="hero" id="hero">
  <div class="hero-orb orb-1"></div>
  <div class="hero-orb orb-2"></div>
  <div class="hero-bg-code" id="bgCode"></div>
  
  <div class="hero-content">
    <div class="hero-left">
      <div class="hero-tag">
        <span class="tag-dot"></span>
        Web & Flutter Developer — Egypt 🇪🇬
      </div>
      <h1 class="hero-name">
        <span class="first">Taha</span>
        <span class="last">Mahmoud.</span>
      </h1>
      <div class="hero-role">
        <span style="color:var(--green);">$</span>
        <span class="typed-text" id="typed"></span><span style="color:var(--green);animation:blink 1s steps(1) infinite;">_</span>
      </div>
      <p class="hero-desc">I build fast, scalable web &amp; mobile applications. Focused on clean architecture, great UX, and code that actually ships.</p>
      
      <div class="hero-tech-stack">
        <span class="ht-label">// core_stack</span>
        <div class="ht-icons">
          <div class="ht-icon-wrap" style="animation-delay: 0.0s"><img src="/icons/icon-1.png" alt="Tech" class="ht-icon" /></div>
          <div class="ht-icon-wrap" style="animation-delay: 0.1s"><img src="/icons/icon-2.png" alt="Tech" class="ht-icon" /></div>
          <div class="ht-icon-wrap" style="animation-delay: 0.2s"><img src="/icons/icon-3.png" alt="Tech" class="ht-icon" /></div>
          <div class="ht-icon-wrap" style="animation-delay: 0.3s"><img src="/icons/icon-4.png" alt="Tech" class="ht-icon" /></div>
          <div class="ht-icon-wrap" style="animation-delay: 0.4s"><img src="/icons/icon-5.png" alt="Tech" class="ht-icon" /></div>
        </div>
      </div>

      <div class="hero-btns">
        <a href="#projects" class="btn btn-green">View Projects →</a>
        <a href="#contact" class="btn btn-ghost">Let's Talk</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><div class="num">10+</div><div class="lbl">// projects</div></div>
        <div class="hero-stat"><div class="num">3+</div><div class="lbl">// years exp</div></div>
        <div class="hero-stat"><div class="num">5+</div><div class="lbl">// happy clients</div></div>
      </div>
    </div>
    
    <div class="hero-right reveal on">
      <div class="hero-image-wrap">
        <img src="/profile.jpg" alt="Taha Mahmoud" class="hero-image">
        <div class="hero-image-overlay"></div>
      </div>
    </div>
  </div>
</div>

<style>
/* ─── Hero ───────────────────────────────────────────────────── */
@keyframes float-icon { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
.hero-tech-stack{display:inline-flex;align-items:center;gap:20px;margin-bottom:32px;background:var(--bg2);padding:10px 24px;border-radius:100px;border:1px solid var(--border);box-shadow:0 8px 32px rgba(0,0,0,0.2);}
.ht-label{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--green);text-transform:uppercase;letter-spacing:2px;}
.ht-icons{display:flex;align-items:center;gap:18px;}
.ht-icon-wrap { animation: float-icon 3s ease-in-out infinite; }
.ht-icon{height:26px;filter:grayscale(100%) opacity(0.6);transition:all 0.4s cubic-bezier(0.16,1,0.3,1);cursor:none;display:block;}
.ht-icon-wrap:hover .ht-icon{filter:grayscale(0%) opacity(1);transform:scale(1.25);}

.hero{
  min-height:calc(100vh - 58px);display:flex;align-items:center;justify-content:space-between;
  padding:0 40px;position:relative;overflow:hidden;max-width:1200px;margin:0 auto;width:100%;
}
/* Dot grid background */
.hero::before{
  content:'';position:absolute;inset:0;
  background-image:radial-gradient(circle, rgba(48,54,61,0.6) 1px, transparent 1px);
  background-size:28px 28px;pointer-events:none;
}
/* Glow orbs */
.hero-orb{position:absolute;border-radius:50%;pointer-events:none;filter:blur(80px);}
.orb-1{width:400px;height:400px;background:rgba(57,211,83,0.06);right:-80px;top:10%;}
.orb-2{width:300px;height:300px;background:rgba(88,166,255,0.06);right:20%;bottom:10%;}

.hero-bg-code{
  position:absolute;right:0;top:0;bottom:0;width:50%;
  opacity:0.055;overflow:hidden;pointer-events:none;
  padding:60px 40px;font-family:'JetBrains Mono',monospace;
  font-size:11.5px;line-height:1.9;color:var(--green);white-space:pre;
  -webkit-mask-image:linear-gradient(to right,transparent,rgba(0,0,0,0.7) 30%,rgba(0,0,0,0.7) 70%,transparent);
  mask-image:linear-gradient(to right,transparent,rgba(0,0,0,0.7) 30%,rgba(0,0,0,0.7) 70%,transparent);
}

.hero-content{display:flex;align-items:center;justify-content:space-between;width:100%;max-width:1100px;margin:0 auto;gap:40px;z-index:2;}
.hero-right{position:relative;z-index:2;flex-shrink:0;}
.hero-image-wrap{width:290px;height:380px;border-radius:24px;overflow:hidden;border:1px solid var(--border);position:relative;box-shadow:0 0 40px rgba(57,211,83,0.05);transform:rotate(3deg) translateY(0);transition:all 0.4s cubic-bezier(0.175,0.885,0.32,1.275);cursor:none;}
.hero-image-wrap:hover{transform:rotate(0deg) translateY(-8px);border-color:var(--green);box-shadow:0 12px 48px rgba(57,211,83,0.18);}
.hero-image{width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease, filter 0.4s ease;filter:contrast(105%) brightness(95%);}
.hero-image-wrap:hover .hero-image{transform:scale(1.05);filter:contrast(110%) brightness(105%);}
.hero-image-overlay{position:absolute;inset:0;background:linear-gradient(135deg,rgba(57,211,83,0.15) 0%,rgba(88,166,255,0.1) 100%);mix-blend-mode:overlay;pointer-events:none;transition:opacity 0.4s ease;}
.hero-image-wrap:hover .hero-image-overlay{opacity:0;}

.hero-left{max-width:580px;z-index:2;}
.hero-tag{
  font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--green);
  margin-bottom:20px;display:inline-flex;align-items:center;gap:10px;
  padding:6px 14px;background:var(--glow-green);border:1px solid rgba(57,211,83,0.2);border-radius:20px;
}
.tag-dot{width:6px;height:6px;background:var(--green);border-radius:50%;animation:pulse 2s infinite;}
.hero-name{font-size:clamp(44px,6vw,78px);font-weight:800;line-height:0.95;margin-bottom:10px;letter-spacing:-3px;}
.hero-name .first{color:var(--white);display:block;}
.hero-name .last{
  display:block;
  color:transparent;
  background:linear-gradient(135deg,var(--cyan) 0%,var(--purple) 100%);
  -webkit-background-clip:text;background-clip:text;
}
.hero-role{font-family:'JetBrains Mono',monospace;font-size:15px;color:var(--muted);margin-bottom:24px;display:flex;align-items:center;gap:6px;}
.typed-text{color:var(--orange);}
.hero-desc{font-size:16px;color:var(--muted);line-height:1.75;max-width:460px;margin-bottom:36px;}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;}
.btn{
  padding:12px 24px;border-radius:8px;font-size:13px;font-weight:600;
  cursor:none;transition:all 0.25s;text-decoration:none;
  display:inline-flex;align-items:center;gap:8px;
  font-family:'JetBrains Mono',monospace;border:none;
}
.btn-green{background:var(--green);color:#0d1117;box-shadow:0 0 20px rgba(57,211,83,0.2);}
.btn-green:hover{background:#4ae168;transform:translateY(-2px);box-shadow:0 4px 24px rgba(57,211,83,0.35);}
.btn-ghost{background:transparent;color:var(--white);border:1px solid var(--border);}
.btn-ghost:hover{border-color:var(--cyan);color:var(--cyan);transform:translateY(-2px);background:rgba(88,166,255,0.05);}
.hero-stats{display:flex;gap:36px;margin-top:48px;padding-top:32px;border-top:1px solid var(--border);}
.hero-stat .num{font-size:30px;font-weight:800;color:var(--white);}
.hero-stat .lbl{font-size:11px;color:var(--muted);margin-top:3px;font-family:'JetBrains Mono',monospace;}

@media(max-width:900px){
  .hero-content{flex-direction:column;text-align:center;justify-content:center;gap:40px;margin-top:20px;}
  .hero-left{display:flex;flex-direction:column;align-items:center;}
  .hero-desc{text-align:center;}
  .hero-btns{justify-content:center;}
  .hero-stats{justify-content:center;flex-wrap:wrap;}
}
@media(max-width:640px){
  .hero{padding:40px 16px;}
  .hero-stats{gap:24px;}
  .hero-stat .num{font-size:24px;}
}
</style>

<script>
/* ── Typewriter ── */
const roles=['Web Developer','Angular Specialist','Flutter Developer','UI/UX Focused Dev','Freelance Developer'];
let ri=0,ci=0,del=false;
const tel=document.getElementById('typed');
function typeIt(){
  if(!tel) return;
  const r=roles[ri];
  if(!del){
    tel.textContent=r.slice(0,++ci);
    if(ci===r.length){del=true;setTimeout(typeIt,1900);return;}
  }else{
    tel.textContent=r.slice(0,--ci);
    if(ci===0){del=false;ri=(ri+1)%roles.length;}
  }
  setTimeout(typeIt,del?45:75);
}
typeIt();

/* ── Background code ── */
const bgCode = document.getElementById('bgCode');
if (bgCode) {
  bgCode.textContent=`import { Component, OnInit } from '@angular/core';
import { ProductService } from './product.service';

@Component({ selector: 'app-root', template: '...' })
export class AppComponent implements OnInit {
  products: Product[] = [];

  constructor(private svc: ProductService) {}

  ngOnInit() {
    this.svc.getAll().subscribe(p => this.products = p);
  }
}

// Supabase real-time subscription
const channel = supabase
  .channel('products')
  .on('postgres_changes', {
    event: '*', schema: 'public'
  }, payload => console.log(payload))
  .subscribe();

// Flutter Widget
Widget build(BuildContext ctx) => Scaffold(
  body: StreamBuilder<List<Order>>(
    stream: supabase.from('orders').stream(
      primaryKey: ['id']
    ),
    builder: (ctx, snap) => OrderList(snap.data ?? []),
  ),
);`;
}
</script>
