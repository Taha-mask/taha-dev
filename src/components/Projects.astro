---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();

const caseStudies = t.caseStudies;
const otherBuilds = t.otherBuilds;
---
<section class="projects" id="projects">
  <div class="sec-header reveal">
    <div class="sec-tag">{t.projectsSec.tag}</div>
    <h2 class="sec-title">{t.projectsSec.title}</h2>
    <p class="sec-sub">{t.projectsSec.sub}</p>
  </div>

  <div class="cs reveal">
    <div class="cs-rail" role="tablist">
      {caseStudies.map((cs, i) => (
        <button
          class={`cs-tab ${i === 0 ? 'active' : ''}`}
          data-target={cs.id}
          role="tab"
          type="button"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${cs.id}`}
        >
          <span class="cs-tab-num" dir="ltr">{cs.num}</span>
          <span class="cs-tab-name">{cs.title.split('—')[0].trim()}</span>
        </button>
      ))}
    </div>

    <div class="cs-panels">
      {caseStudies.map((cs, i) => (
        <article class={`cs-panel ${i === 0 ? 'active' : ''}`} id={`panel-${cs.id}`} role="tabpanel" tabindex="0">
          <header class="cs-head">
            <h3>{cs.title}</h3>
            <p class={`cs-status ${cs.statusClass}`}><span class="cs-status-dot" aria-hidden="true"></span>{cs.status}</p>
          </header>

          <!-- Three facts, as a definition list. They used to be icon rows;
               the icons said nothing the labels did not already say. -->
          <dl class="cs-facts">
            <div><dt>{t.projectsSec.role}</dt><dd>{cs.role}</dd></div>
            <div><dt>{t.projectsSec.surface}</dt><dd dir="ltr">{cs.surface}</dd></div>
            <div><dt>{t.projectsSec.audience}</dt><dd>{cs.audience}</dd></div>
          </dl>

          <div class="cs-tech" dir="ltr">
            {cs.tech.map(tech => <span class="tag">{tech}</span>)}
          </div>

          <div class="cs-body">
            <div class="cs-block">
              <h4>{t.projectsSec.problemLabel}</h4>
              <p>{cs.problem}</p>
            </div>
            <div class="cs-block">
              <h4>{t.projectsSec.approachLabel}</h4>
              <p>{cs.approach}</p>
            </div>
            <div class="cs-block">
              <h4>{t.projectsSec.challengeLabel}</h4>
              <p>{cs.challenge}</p>
            </div>
            <div class="cs-block">
              <h4>{t.projectsSec.resultLabel}</h4>
              <p>{cs.result}</p>
            </div>
          </div>

          <footer class="cs-foot">
            {cs.live && <a href={cs.live} target="_blank" rel="noopener" class="btn btn-primary">{cs.liveLabel || t.projectsSec.visitLive}</a>}
            {cs.gh && <a href={cs.gh} target="_blank" rel="noopener" class="btn btn-ghost">{t.projectsSec.viewSource}</a>}
            {!cs.live && !cs.gh && <span class="cs-private">{t.projectsSec.privateSource}</span>}
          </footer>
        </article>
      ))}
    </div>
  </div>

  <div class="other reveal">
    <h3 class="other-title">{t.projectsSec.otherTitle}</h3>
    <ul class="other-list reveal-group">
      {otherBuilds.map(ob => (
        <li class="other-row">
          <div>
            <h4>{ob.title}</h4>
            <p>{ob.desc}</p>
          </div>
          {ob.gh && <a href={ob.gh} target="_blank" rel="noopener" class="link other-link">{t.projectsSec.ghLabel}</a>}
          {!ob.gh && <span class="other-link meta">{t.projectsSec.privateRepo}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
/* ─── Case studies ───────────────────────────────────────────────
   Five projects, each with four paragraphs of write-up. Stacked, that is a
   wall no one reads; as tabs, the visitor picks one and reads it. The tabs
   stay — what goes is the packaging: the panel used to be a bordered card
   holding bordered rows holding bordered pills. Now the rail and the panel
   share one hairline and the type does the rest of the work. */
.cs{display:grid;gap:28px;}
@media(min-width:820px){
  .cs{grid-template-columns:210px 1fr;gap:44px;align-items:start;}
}

/* ─── Rail ───────────────────────────────────────────────────── */
.cs-rail{
  display:flex;gap:8px;
  overflow-x:auto;padding-bottom:10px;
  scrollbar-width:none;
}
.cs-rail::-webkit-scrollbar{display:none;}
@media(min-width:820px){
  .cs-rail{
    flex-direction:column;gap:0;padding-bottom:0;
    border-inline-start:1px solid var(--border);
    position:sticky;top:96px;
  }
}

.cs-tab{
  position:relative;
  display:flex;align-items:baseline;gap:10px;
  background:transparent;border:1px solid var(--border);
  border-radius:var(--radius);padding:9px 14px;
  text-align:start;white-space:nowrap;cursor:pointer;
  color:var(--text-3);
  transition:
    color var(--t-fast) var(--ease-soft),
    border-color var(--t-fast) var(--ease-soft),
    background-color var(--t-fast) var(--ease-soft),
    transform var(--t-mid) var(--ease-out);
}
@media(min-width:820px){
  .cs-tab{
    border:none;border-radius:0;
    margin-inline-start:-1px;padding:11px 16px;
    white-space:normal;
  }
  /* The active marker is a pseudo-element rather than a border colour, so it
     can grow from the middle of the tab instead of switching on. Two pixels
     of accent unrolling down the rail is the clearest possible answer to
     "which one did I just click". */
  .cs-tab::before{
    content:'';position:absolute;
    inset-block:0;inset-inline-start:0;width:2px;
    background:var(--accent);
    transform:scaleY(0);transform-origin:center;
    transition:transform var(--t-mid) var(--ease-out);
  }
  .cs-tab:hover::before{transform:scaleY(0.4);background:var(--border-strong);}
  .cs-tab.active::before{transform:scaleY(1);background:var(--accent);}
}
/* Below 820px the rail is a row of pills, so the marker is the border again
   and the nudge is horizontal. */
.cs-tab:hover{color:var(--text);}
@media(max-width:819px){
  .cs-tab:hover{background:var(--surface);transform:translateY(-2px);}
  .cs-tab.active{border-color:var(--accent);}
}
.cs-tab.active{color:var(--text);}

.cs-tab-num{
  font-family:var(--font-mono);font-size:11px;color:var(--text-3);
  transition:color var(--t-fast) var(--ease-soft);
}
.cs-tab.active .cs-tab-num{color:var(--accent);}
.cs-tab-name{font-size:14px;font-weight:500;}

/* ─── Panel ──────────────────────────────────────────────────── */
.cs-panel{display:none;}
/* A panel that swaps instantly reads as the page having been replaced; one
   that rises 8px reads as this panel arriving. The animation re-runs on every
   switch for free, because a CSS animation restarts whenever an element goes
   from display:none to display:block. */
.cs-panel.active{display:block;animation:panel-in 0.42s var(--ease-out);}
@keyframes panel-in{
  from{opacity:0;transform:translateY(8px);}
  to{opacity:1;transform:none;}
}
.cs-panel:focus-visible{outline-offset:6px;}

.cs-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 16px;}
.cs-head h3{font-size:24px;}

/* Status as a dot and a word. Three states used to mean three colours
   (green / blue / orange); the dot carries the difference now — filled for
   something you can go and use, hollow for work still in progress. */
.cs-status{
  display:inline-flex;align-items:center;gap:7px;
  font-family:var(--font-mono);font-size:11px;
  letter-spacing:0.08em;text-transform:uppercase;color:var(--text-3);
}
.cs-status-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--accent);flex-shrink:0;
}
.status-wip .cs-status-dot{background:transparent;border:1px solid var(--text-3);}

.cs-facts{
  display:grid;gap:10px 28px;
  margin-top:18px;
}
@media(min-width:560px){
  .cs-facts{grid-template-columns:repeat(3,auto);justify-content:start;}
}
.cs-facts dt{
  font-family:var(--font-mono);font-size:11px;
  letter-spacing:0.08em;text-transform:uppercase;color:var(--text-3);
}
.cs-facts dd{font-size:14px;color:var(--text-2);margin-top:3px;}

.cs-tech{display:flex;flex-wrap:wrap;gap:6px;margin-top:20px;}

/* The four write-up blocks are the only real reading on the page, so they get
   book settings rather than UI settings: 16px, generous leading, and a
   measure capped in ch. Without the cap the panel grows to the full desktop
   width — ~140 characters a line, where the eye loses its place on every
   carriage return. */
.cs-body{
  display:flex;flex-direction:column;gap:22px;
  margin-top:28px;padding-top:24px;
  border-top:1px solid var(--border);
}
.cs-block h4{
  font-family:var(--font-mono);font-size:11px;font-weight:500;
  letter-spacing:0.1em;text-transform:uppercase;
  color:var(--text-3);margin-bottom:6px;
}
.cs-block p{font-size:16px;color:var(--text-2);max-width:var(--measure);}

.cs-foot{
  display:flex;flex-wrap:wrap;gap:10px;align-items:center;
  margin-top:28px;
}
.cs-private{font-family:var(--font-mono);font-size:12px;color:var(--text-3);}

/* ─── Other builds ───────────────────────────────────────────────
   Smaller work, so it gets a smaller shape: rows split by hairlines instead
   of a grid of cards competing with the case studies above. */
.other{margin-top:64px;}
.other-title{
  font-size:18px;margin-bottom:8px;
}
.other-list{list-style:none;}
.other-row{
  position:relative;
  display:flex;align-items:baseline;justify-content:space-between;gap:20px;
  padding:18px 0;border-bottom:1px solid var(--border);
  transition:border-color var(--t-mid) var(--ease-soft);
}
/* The row's whole hover response: it slides --nudge towards the reading
   direction and a short accent tick appears in the margin it just left.
   Padding, not transform, so the tick stays anchored where the row was —
   the text moves, the mark does not. */
.other-row > div{
  transition:transform var(--t-mid) var(--ease-out),color var(--t-mid) var(--ease-soft);
}
.other-row::before{
  content:'';position:absolute;
  inset-inline-start:calc(var(--nudge) * -4);top:24px;
  width:0;height:1px;background:var(--accent);
  transition:width var(--t-mid) var(--ease-out);
}
.other-row:hover{border-color:var(--border-strong);}
.other-row:hover::before{width:8px;}
.other-row:hover > div{transform:translateX(var(--nudge));}
:global([dir="rtl"]) .other-row:hover > div{transform:translateX(calc(var(--nudge) * -1));}

.other-row h4{
  font-family:var(--font-sans);font-size:15px;font-weight:600;letter-spacing:0;
  transition:color var(--t-fast) var(--ease-soft);
}
.other-row:hover h4{color:var(--accent);}
.other-row p{font-size:14px;color:var(--text-2);margin-top:3px;max-width:60ch;}
.other-link{
  font-family:var(--font-mono);font-size:12px;
  white-space:nowrap;flex-shrink:0;
}

@media(max-width:560px){
  .other-row{flex-direction:column;gap:8px;}
}

@media (prefers-reduced-motion: reduce){
  .cs-tab:hover,.other-row:hover > div{transform:none;}
  .cs-panel.active{animation:none;}
}
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.cs-tab');
  const panels = document.querySelectorAll<HTMLElement>('.cs-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach(p => p.classList.remove('active'));

      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const targetId = tab.dataset.target;
      if (!targetId) return;
      document.getElementById(`panel-${targetId}`)?.classList.add('active');
    });
  });
</script>
