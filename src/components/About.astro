---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();
const a = t.about;

/* The same ten facts the old terminal block printed as JSON, as data instead
   of markup — the section below is a list, so it should be built from one. */
const facts = [
  { label: a.nameLabel, value: a.nameVal },
  { label: a.ageLabel, value: a.ageVal },
  { label: a.roleLabel, value: a.roleVal },
  { label: a.univLabel, value: a.univVal },
  { label: a.buildingLabel, value: a.buildingVal },
  { label: a.webStackLabel, value: a.webStackVal },
  { label: a.mobileStackLabel, value: a.mobileStackVal },
  { label: a.interestsLabel, value: a.interestsVal },
  { label: a.openLabel, value: a.openVal },
];
---
<section class="about" id="about">
  <div class="sec-header reveal">
    <div class="sec-tag">{a.tag}</div>
    <h2 class="sec-title">{a.title}</h2>
  </div>

  <dl class="facts reveal">
    {facts.map(fact => (
      <div class="fact">
        <dt>{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
    <div class="fact">
      <dt>{a.emailLabel}</dt>
      <dd><a class="link" href={`mailto:${a.emailVal}`} dir="ltr">{a.emailVal}</a></dd>
    </div>
  </dl>

  <p class="about-note reveal">{a.comment}</p>
</section>

<style>

/* ─── About ───────────────────────────────────────────────────── */

.about {
  position: relative;
}

/* Section heading */
.sec-header {
  margin-bottom: 42px;
}

.sec-tag {
  margin-bottom: 10px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-3);
}

.sec-title {
  margin: 0;
  font-size: clamp(32px, 4vw, 46px);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

/* Facts */
.facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 64px;
  max-width: 960px;
  margin: 0;
  padding: 0;
}

.fact {
  display: grid;
  grid-template-columns: 125px minmax(0, 1fr);
  align-items: baseline;
  gap: 24px;

  min-height: 52px;
  padding: 15px 0;

  border-bottom: 1px solid var(--border);

  transition:
    border-color 180ms ease,
    transform 180ms ease;
}

.fact:hover {
  border-color: var(--text-3);
  transform: translateX(3px);
}

.fact dt {
  margin: 0;

  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.11em;
  text-transform: uppercase;

  color: var(--text-3);
}

.fact dd {
  min-width: 0;
  margin: 0;

  font-size: 14px;
  line-height: 1.6;
  color: var(--text-2);

  overflow-wrap: anywhere;
  unicode-bidi: isolate;
}

/* Email */
.fact:last-child dd {
  color: var(--text);
}

.link {
  position: relative;
  color: inherit;
  text-decoration: none;
  transition: color 180ms ease;
}

.link::after {
  content: "";

  position: absolute;
  left: 0;
  right: 0;
  bottom: -3px;

  height: 1px;
  background: currentColor;

  transform: scaleX(0);
  transform-origin: right;
  transition: transform 220ms ease;
}

.link:hover {
  color: var(--text);
}

.link:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

/* Personal note */
.about-note {
  max-width: 720px;
  margin: 42px 0 0;

  font-family: var(--font-serif);
  font-size: clamp(17px, 2vw, 20px);
  font-style: italic;
  line-height: 1.65;

  color: var(--text-2);
}

/* ─── Tablet ──────────────────────────────────────────────────── */

@media (max-width: 820px) {
  .facts {
    grid-template-columns: 1fr;
    column-gap: 0;
  }

  .fact {
    grid-template-columns: 145px minmax(0, 1fr);
  }
}

/* ─── Mobile ─────────────────────────────────────────────────── */

@media (max-width: 520px) {
  .sec-header {
    margin-bottom: 30px;
  }

  .facts {
    width: 100%;
  }

  .fact {
    grid-template-columns: 1fr;
    gap: 5px;

    min-height: auto;
    padding: 13px 0;
  }

  .fact dt {
    font-size: 9px;
  }

  .fact dd {
    font-size: 14px;
  }

  .about-note {
    margin-top: 32px;
    font-size: 17px;
  }

  .fact:hover {
    transform: none;
  }
}


</style>
