---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();

const webSkills = t.skills.webSkills;
const flutterSkills = t.skills.flutterSkills;
---
<section class="skills" id="skills">
  <div class="sec-header reveal">
    <div class="sec-tag">{t.skills.tag}</div>
    <h2 class="sec-title">{t.skills.title}</h2>
    <p class="sec-sub">{t.skills.sub}</p>
  </div>

  <div class="skill-cols">
    <div class="reveal">
      <h3 class="skill-col-title">{t.skills.webCol}</h3>
      <ul class="skill-list">
        {webSkills.map(s => (
          <li class="skill" dir="ltr">
            <span class="skill-name">{s.n}</span>
            <span class="skill-track"><span class="skill-fill" data-w={s.pct}></span></span>
            <span class="skill-pct">{s.pct}%</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="reveal">
      <h3 class="skill-col-title">{t.skills.flutterCol}</h3>
      <ul class="skill-list">
        {flutterSkills.map(s => (
          <li class="skill" dir="ltr">
            <span class="skill-name">{s.n}</span>
            <span class="skill-track"><span class="skill-fill" data-w={s.pct}></span></span>
            <span class="skill-pct">{s.pct}%</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
/* ─── Skills ─────────────────────────────────────────────────────
   Two lists, one line per tool. Every bar used to be painted in that tool's
   own brand colour — fourteen rows, eleven different hues, which turned an
   honest list into a paint chart and made the section the loudest thing on
   the page. The bars are still here, because a length is easier to read at a
   glance than a number, but they are all the same quiet accent and only 2px
   tall: a sparkline, not a progress bar. */
.skill-cols{
  display:grid;grid-template-columns:1fr 1fr;
  gap:40px 56px;
}

.skill-col-title{
  font-family:var(--font-sans);font-size:15px;font-weight:600;
  color:var(--text);letter-spacing:0;
  padding-bottom:12px;margin-bottom:6px;
  border-bottom:1px solid var(--border);
}

.skill-list{list-style:none;}
.skill{
  display:grid;grid-template-columns:1fr 84px 34px;
  align-items:center;gap:14px;
  padding:9px 0;
}
.skill-name{
  font-size:14.5px;color:var(--text-2);
  transition:color var(--t-fast) var(--ease-soft);
}

.skill-track{
  height:2px;background:var(--surface-2);border-radius:2px;overflow:hidden;
  transition:height var(--t-mid) var(--ease-out);
}
.skill-fill{
  display:block;height:100%;width:0;
  background:var(--accent);opacity:0.65;
  /* The fill is staggered per row by --fill-delay, set by the script below.
     Fourteen bars all filling on the same frame is a loading screen; the same
     fourteen dealt 60ms apart is a list being read out. */
  transition:
    width 0.95s var(--ease-out) var(--fill-delay,0ms),
    opacity var(--t-mid) var(--ease-soft);
}
.skill-pct{
  font-family:var(--font-mono);font-size:11.5px;
  color:var(--text-3);text-align:end;
  transition:color var(--t-fast) var(--ease-soft);
}

/* Hovering a row brings its name and figure up a step and thickens the bar
   from 2px to 4px. A sparkline that answers the pointer is the cheapest way
   to say "this is a list you can read down", rather than a static chart. */
.skill:hover .skill-name{color:var(--text);}
.skill:hover .skill-pct{color:var(--text-2);}
.skill:hover .skill-track{height:4px;}
.skill:hover .skill-fill{opacity:1;}

@media(max-width:700px){
  .skill-cols{grid-template-columns:1fr;gap:32px;}
}
</style>

<script>
  /* Fill the bars once the list is actually on screen, rather than on a timer
     that may well have fired before the visitor scrolled this far. */
  const skillList = document.querySelector('.skill-cols');

  if (skillList) {
    const fill = () => {
      /* Per column, not per page: the two lists sit side by side, so counting
         across both would leave the right-hand column waiting on the left
         one's fourteen rows before it started. */
      document.querySelectorAll<HTMLElement>('.skill-list').forEach(list => {
        list.querySelectorAll<HTMLElement>('.skill-fill').forEach((bar, i) => {
          bar.style.setProperty('--fill-delay', `${i * 60}ms`);
          bar.style.width = (bar.dataset.w || '0') + '%';
        });
      });
    };

    const skillObserver = new IntersectionObserver((entries, observer) => {
      if (!entries[0].isIntersecting) return;
      fill();
      observer.disconnect();
    }, { threshold: 0.2 });

    skillObserver.observe(skillList);
  }
</script>
