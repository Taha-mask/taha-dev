---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();
---
<section class="contact" id="contact">
  <div class="sec-header reveal">
    <div class="sec-tag">{t.contact.tag}</div>
    <h2 class="sec-title">{t.contact.title}</h2>
    <p class="sec-sub">{t.contact.sub}</p>
  </div>

  <div class="contact-grid">
    <ul class="contact-list reveal">
      <li>
        <span class="contact-label">{t.contact.emailLabel}</span>
        <a class="link" href="mailto:iam.tahamahmoud@gmail.com" dir="ltr">iam.tahamahmoud@gmail.com</a>
      </li>
      <li>
        <span class="contact-label">{t.contact.githubLabel}</span>
        <a class="link" href="https://github.com/Taha-mask" target="_blank" rel="noopener" dir="ltr">github.com/Taha-mask</a>
      </li>
      <li>
        <span class="contact-label">{t.contact.linkedinLabel}</span>
        <a class="link" href="https://www.linkedin.com/in/taha-mahmoud-8b6914269?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app" target="_blank" rel="noopener" dir="ltr">linkedin.com/in/taha-mahmoud</a>
      </li>
      <li>
        <span class="contact-label">{t.contact.locationLabel}</span>
        <span class="contact-plain">{t.contact.locationVal}</span>
      </li>
    </ul>

    <form class="contact-form reveal" id="contactForm">
      <!-- Web3Forms access key (from https://web3forms.com) — this is meant to be
           public/client-side, it just identifies which account submissions go to. -->
      <input type="hidden" name="access_key" value="053c2490-5411-4010-af41-54185f924a13" />
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
      <input class="field" type="text" name="name" placeholder={t.contact.formName} required />
      <input class="field" type="email" name="email" placeholder={t.contact.formEmail} required dir="ltr" style={lang === 'ar' ? 'text-align: right;' : ''} />
      <select class="field" name="project" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
        <option value="" disabled selected>{t.contact.formProject}</option>
        <option>{t.contact.optWeb}</option>
        <option>{t.contact.optFlutter}</option>
        <option>{t.contact.optBoth}</option>
        <option>{t.contact.optOther}</option>
      </select>
      <textarea class="field" name="message" rows="5" placeholder={t.contact.formMsg} required></textarea>
      <button class="btn btn-primary send-btn" type="submit" id="sendBtn">{t.contact.sendBtn}</button>
      <p class="form-status" id="cfStatus" aria-live="polite"></p>
    </form>
  </div>
</section>

<footer>
  <div class="footer-inner">
    <span class="footer-brand" dir="ltr"><span class="bracket">&lt;</span>taha<span class="bracket">.dev /&gt;</span></span>
    <p class="footer-copy">{t.footer.crafted} — 2025</p>
    <nav class="footer-links">
      <a href="https://github.com/Taha-mask" target="_blank" rel="noopener">{t.footer.github}</a>
      <a href="https://www.linkedin.com/in/taha-mahmoud-8b6914269?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app" target="_blank" rel="noopener">{t.footer.linkedin}</a>
      <a href="mailto:iam.tahamahmoud@gmail.com">{t.footer.email}</a>
    </nav>
  </div>
</footer>

<style>
/* ─── Contact ────────────────────────────────────────────────────
   Two columns: the ways to reach him, and a form for people who would rather
   not open their mail client. The four contact rows used to be bordered
   cards with icon tiles that lit up cyan on hover; they are addresses, and
   an address only needs to be legible and clickable. */
.contact-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:48px;
  align-items:start;
}

.contact-list{list-style:none;}
.contact-list li{
  display:flex;flex-direction:column;gap:2px;
  padding:14px 0;border-bottom:1px solid var(--border);
}
.contact-list li:first-child{border-top:1px solid var(--border);}
.contact-label{
  font-family:var(--font-mono);font-size:11.5px;
  letter-spacing:0.06em;text-transform:uppercase;color:var(--text-3);
}
.contact-list a,.contact-plain{font-size:15px;align-self:flex-start;}
.contact-plain{color:var(--text-2);}

/* ─── Form ───────────────────────────────────────────────────────
   Sans, not mono: a name typed into a monospaced box looks like a config
   value. One border, one focus ring, no glow. */
.contact-form{display:flex;flex-direction:column;gap:12px;}
.field{
  width:100%;
  background:var(--surface);
  border:1px solid var(--border);border-radius:var(--radius);
  padding:11px 13px;
  font-family:var(--font-sans);font-size:15px;color:var(--text);
  outline:none;resize:vertical;
  transition:border-color 0.15s;
}
.field:focus{border-color:var(--accent);}
.field::placeholder{color:var(--text-3);}
select.field{cursor:pointer;}
/* Windows renders the dropdown list with the OS palette unless the options
   carry their own colours — without this the list is white-on-white in the
   dark theme. */
select.field option{background:var(--surface);color:var(--text);}

.send-btn{margin-top:4px;padding:12px 20px;}
.send-btn:disabled{opacity:0.6;cursor:default;}
.form-status{font-size:13px;color:var(--text-3);min-height:18px;}
.form-status.err{color:var(--danger);}

/* ─── Footer ─────────────────────────────────────────────────────
   One line, sitting on the page's own background with a hairline above it —
   not a darker slab announcing that the site has ended. */
footer{border-top:1px solid var(--border);}
.footer-inner{
  max-width:1060px;margin-inline:auto;
  padding:28px;
  display:flex;flex-wrap:wrap;align-items:center;
  justify-content:space-between;gap:12px 24px;
}
.footer-brand{font-family:var(--font-mono);font-size:13px;color:var(--text-2);unicode-bidi:isolate;}
.footer-brand .bracket{color:var(--text-3);}
.footer-copy{font-size:13px;color:var(--text-3);}
.footer-links{display:flex;gap:18px;}
.footer-links a{font-size:13px;color:var(--text-3);text-decoration:none;transition:color 0.15s;}
.footer-links a:hover{color:var(--text);}

@media(max-width:820px){
  .contact-grid{grid-template-columns:1fr;gap:36px;}
}
@media(max-width:640px){
  .footer-inner{padding:24px 20px;flex-direction:column;align-items:flex-start;}
}
</style>

<script define:vars={{
  noAccessKey: t.contact.noAccessKey,
  sending: t.contact.sending,
  success: t.contact.success,
  failed: t.contact.failed,
  errorMsg: t.contact.errorMsg,
  sendBtnLabel: t.contact.sendBtn
}}>
  const form = document.getElementById('contactForm');
  const status = document.getElementById('cfStatus');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('sendBtn');
      if (!btn) return;

      const accessKey = form.elements.namedItem('access_key')?.value;
      if (!accessKey || accessKey === 'YOUR_WEB3FORMS_ACCESS_KEY') {
        if (status) { status.textContent = noAccessKey; status.classList.add('err'); }
        return;
      }

      btn.textContent = sending;
      btn.setAttribute('disabled', 'true');
      if (status) { status.textContent = ''; status.classList.remove('err'); }

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = await res.json();
        if (!res.ok || !result.success) throw new Error(result.message || 'Send failed');

        // The result is said in words on the button itself, so there is no
        // colour swap here — nothing on this page turns green or red to
        // report a state.
        btn.textContent = success;
        form.reset();
      } catch (err) {
        btn.textContent = failed;
        if (status) { status.textContent = errorMsg; status.classList.add('err'); }
        console.error('Contact form error:', err);
      } finally {
        setTimeout(() => {
          btn.textContent = sendBtnLabel;
          btn.removeAttribute('disabled');
        }, 3000);
      }
    });
  }
</script>
