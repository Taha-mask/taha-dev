---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();
---
<header class="site-head">
  <div class="head-inner">
    <!-- dir="ltr" because the wordmark is code, not prose: in the Arabic
         locale the bidi algorithm otherwise reorders the angle brackets and
         the slash into "</ taha.dev>". -->
    <a class="wordmark" href="#top" dir="ltr">
      <span class="bracket">&lt;</span>taha<span class="bracket">.dev /&gt;</span>
    </a>

    <nav class="nav-links" aria-label={t.nav.projects}>
      <a href="#projects">{t.nav.projects}</a>
      <a href="#skills">{t.nav.skills}</a>
      <a href="#education" class="nav-extra">{t.nav.education}</a>
      <a href="#certifications" class="nav-extra">{t.nav.certs}</a>
      <a href="#about">{t.nav.about}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>

    <div class="head-actions">
      <span class="status"><span class="status-dot" aria-hidden="true"></span>{t.nav.available}</span>
      <LanguagePicker />
      <button
        class="icon-btn"
        id="themeToggle"
        type="button"
        aria-label={t.a11y.switchTheme}
        data-label-light={t.a11y.themeToLight}
        data-label-dark={t.a11y.themeToDark}
      >
        <!-- The icon shows the theme the button switches TO, so it reads as an
             action ("go light") rather than a label for where you already are. -->
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
      <button class="icon-btn hamburger" id="ham" type="button" aria-label={t.a11y.toggleMenu} aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" hidden>
  <a href="#projects" class="menu-link">{t.nav.projects}</a>
  <a href="#skills" class="menu-link">{t.nav.skills}</a>
  <a href="#education" class="menu-link">{t.nav.education}</a>
  <a href="#certifications" class="menu-link">{t.nav.certs}</a>
  <a href="#about" class="menu-link">{t.nav.about}</a>
  <a href="#contact" class="menu-link">{t.nav.contact}</a>
  <span class="menu-status"><span class="status-dot" aria-hidden="true"></span>{t.nav.available}</span>
</div>

<style>
/* ─── Header ─────────────────────────────────────────────────────
   Full-bleed bar, but its contents line up with the 1060px column every
   section uses, so the wordmark sits directly above the page content rather
   than floating off in the corner. Opaque, not translucent: a blurred bar
   over scrolling text is a small readability tax paid on every scroll. */
.site-head{
  position:sticky;top:0;z-index:100;
  background:var(--bg);
  border-bottom:1px solid var(--border);
}
.head-inner{
  max-width:1060px;margin-inline:auto;
  padding:0 28px;height:64px;
  display:flex;align-items:center;gap:24px;
}

.wordmark{
  font-family:var(--font-mono);font-size:14px;
  color:var(--text);text-decoration:none;
  white-space:nowrap;unicode-bidi:isolate;
}
/* The angle brackets are the signature; keeping them a step back stops the
   wordmark reading as punctuation soup. */
.wordmark .bracket{color:var(--text-3);}

.nav-links{display:flex;gap:4px;margin-inline-start:auto;}
.nav-links a{
  font-size:14px;color:var(--text-3);text-decoration:none;
  padding:6px 10px;border-radius:var(--radius-sm);
  transition:color 0.15s;
}
.nav-links a:hover{color:var(--text);}

.head-actions{display:flex;align-items:center;gap:12px;}

.status{
  display:inline-flex;align-items:center;gap:7px;
  font-size:13px;color:var(--text-3);white-space:nowrap;
}
/* Static, not pulsing. A dot that blinks forever in the corner of the screen
   is movement the visitor has to actively ignore. */
.status-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--accent);flex-shrink:0;
}

.icon-btn{
  display:flex;align-items:center;justify-content:center;
  width:32px;height:32px;padding:0;flex-shrink:0;
  background:transparent;border:1px solid var(--border);
  border-radius:var(--radius-sm);color:var(--text-3);cursor:pointer;
  transition:color 0.15s,border-color 0.15s;
}
.icon-btn:hover{color:var(--text);border-color:var(--border-strong);}

/* data-theme lives on <html>, outside this component, so the ancestor half of
   the selector needs :global() to survive Astro's style scoping. */
.icon-sun,.icon-moon{display:none;}
:global(:root:not([data-theme="light"])) .icon-sun{display:block;}
:global(:root[data-theme="light"]) .icon-moon{display:block;}

/* ─── Hamburger ──────────────────────────────────────────────── */
.hamburger{display:none;flex-direction:column;gap:5px;}
.hamburger span{
  display:block;width:16px;height:1.5px;border-radius:2px;
  background:currentColor;transition:transform 0.2s,opacity 0.2s;
}
.hamburger.open span:nth-child(1){transform:translateY(3.25px) rotate(45deg);}
.hamburger.open span:nth-child(2){transform:translateY(-3.25px) rotate(-45deg);}

.mobile-menu{
  position:fixed;top:64px;inset-inline:0;z-index:99;
  background:var(--bg);border-bottom:1px solid var(--border);
  box-shadow:var(--shadow);
  padding:8px 20px 20px;
  flex-direction:column;
}
.mobile-menu:not([hidden]){display:flex;}
.mobile-menu a{
  color:var(--text);text-decoration:none;font-size:16px;
  padding:14px 0;border-bottom:1px solid var(--border);
}
.menu-status{
  display:inline-flex;align-items:center;gap:8px;
  font-size:13px;color:var(--text-3);padding-top:16px;
}

/* Six links plus the availability line overflow the bar below ~940px. The two
   journey links give way first, so the four original links keep the bar
   exactly as it is at these widths; both sections stay in the mobile menu. */
@media(max-width:940px){
  .nav-extra{display:none;}
}
@media(max-width:780px){
  .status{display:none;}
}
@media(max-width:640px){
  .head-inner{padding:0 20px;height:60px;gap:12px;}
  .nav-links{display:none;}
  .hamburger{display:flex;}
  .mobile-menu{top:60px;}
}
</style>

<script>
  /* ── Theme toggle ──
     The initial theme is already on <html> (set pre-paint in Layout.astro);
     this only handles the switch, persists the choice, and keeps the label
     and the browser chrome colour in sync. */
  const themeBtn = document.getElementById('themeToggle');
  const root = document.documentElement;

  /* Both labels are rendered per locale into data- attributes, so the button
     describes itself in the page's own language instead of always announcing
     in English. */
  const describeTheme = (theme: string) => {
    if (!themeBtn) return;
    const label = theme === 'light'
      ? themeBtn.dataset.labelDark
      : themeBtn.dataset.labelLight;
    if (!label) return;
    themeBtn.setAttribute('aria-label', label);
    themeBtn.setAttribute('title', label);
  };

  describeTheme(root.getAttribute('data-theme') || 'dark');

  themeBtn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';

    // Fade the swap instead of snapping it — the class comes straight back off
    // so these transitions never apply during normal scrolling or hover.
    root.classList.add('theme-transition');
    window.setTimeout(() => root.classList.remove('theme-transition'), 250);

    root.setAttribute('data-theme', next);
    describeTheme(next);

    const meta = document.getElementById('themeColor');
    if (meta) meta.setAttribute('content', next === 'light' ? '#fbfbfb' : '#0f0f0f');

    // localStorage throws in private/blocked-cookie contexts; the toggle should
    // still work for this page view even when the choice can't be remembered.
    try { localStorage.setItem('theme', next); } catch { /* not persisted */ }
  });

  const ham = document.getElementById('ham');
  const menu = document.getElementById('mobileMenu');

  if (ham && menu) {
    const setOpen = (open: boolean) => {
      ham.classList.toggle('open', open);
      menu.hidden = !open;
      ham.setAttribute('aria-expanded', String(open));
      // Lock background scroll while the menu covers the page.
      document.body.style.overflow = open ? 'hidden' : '';
    };

    // `hidden` is typed as boolean | "until-found", so compare rather than
    // pass it straight through.
    ham.addEventListener('click', () => setOpen(menu.hidden !== false));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        ham.focus();
      }
    });

    menu.querySelectorAll('.menu-link').forEach(link => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>
