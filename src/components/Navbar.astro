---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();
---
<header class="site-head">
  <div class="head-inner">
    <!-- dir="ltr" because the wordmark is code, not prose: in the Arabic
         locale the bidi algorithm otherwise reorders the angle brackets and
         the slash into "</ taha.dev>". -->
    <a class="wordmark" href="#top" dir="ltr">
      <span class="bracket">&lt;</span>taha<span class="bracket">.dev /&gt;</span>
    </a>

    <nav class="nav-links" aria-label={t.nav.projects}>
      <a href="#projects">{t.nav.projects}</a>
      <a href="#skills">{t.nav.skills}</a>
      <a href="#education" class="nav-extra">{t.nav.education}</a>
      <a href="#certifications" class="nav-extra">{t.nav.certs}</a>
      <a href="#about">{t.nav.about}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>

    <div class="head-actions">
      <span class="status"><span class="status-dot" aria-hidden="true"></span>{t.nav.available}</span>
      <LanguagePicker />
      <button
        class="icon-btn"
        id="themeToggle"
        type="button"
        aria-label={t.a11y.switchTheme}
        data-label-light={t.a11y.themeToLight}
        data-label-dark={t.a11y.themeToDark}
      >
        <!-- The icon shows the theme the button switches TO, so it reads as an
             action ("go light") rather than a label for where you already are. -->
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
      <button class="icon-btn hamburger" id="ham" type="button" aria-label={t.a11y.toggleMenu} aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Sits on the header's bottom edge, replacing the hairline rather than
       adding a second line. Decorative: how far down the page you are is
       already available to a screen reader from the scrollbar. -->
  <div class="scroll-progress" aria-hidden="true"></div>
</header>

<div class="mobile-menu" id="mobileMenu" hidden>
  <a href="#projects" class="menu-link">{t.nav.projects}</a>
  <a href="#skills" class="menu-link">{t.nav.skills}</a>
  <a href="#education" class="menu-link">{t.nav.education}</a>
  <a href="#certifications" class="menu-link">{t.nav.certs}</a>
  <a href="#about" class="menu-link">{t.nav.about}</a>
  <a href="#contact" class="menu-link">{t.nav.contact}</a>
  <span class="menu-status"><span class="status-dot" aria-hidden="true"></span>{t.nav.available}</span>
</div>

<style>
/* ─── Header ─────────────────────────────────────────────────────
   Full-bleed bar, but its contents line up with the 1060px column every
   section uses, so the wordmark sits directly above the page content rather
   than floating off in the corner. Opaque, not translucent: a blurred bar
   over scrolling text is a small readability tax paid on every scroll. */
.site-head{
  position:sticky;top:0;z-index:100;
  background:var(--bg);
  border-bottom:1px solid var(--border);
  /* At the top of the page the bar is part of the hero; once you have
     scrolled it is a thing floating over content, and it earns a shadow.
     The class is set by the scroll handler in Layout.astro. */
  transition:box-shadow var(--t-mid) var(--ease-soft),border-color var(--t-mid) var(--ease-soft);
}
/* position:sticky is itself a positioned element, so the header is already
   the containing block the progress line needs — no extra wrapper. */
.site-head.scrolled{box-shadow:0 1px 20px rgba(0,0,0,0.22);}
:global(:root[data-theme="light"]) .site-head.scrolled{box-shadow:0 1px 20px rgba(15,15,15,0.07);}
.head-inner{
  max-width:1060px;margin-inline:auto;
  padding:0 28px;height:64px;
  display:flex;align-items:center;gap:24px;
}

.wordmark{
  font-family:var(--font-mono);font-size:14px;
  color:var(--text);text-decoration:none;
  white-space:nowrap;unicode-bidi:isolate;
}
/* The angle brackets are the signature; keeping them a step back stops the
   wordmark reading as punctuation soup. On hover they come up to full
   strength and ease outwards, as if the tag were opening slightly. It is the
   smallest possible joke and it only costs two transitions. */
.wordmark .bracket{
  color:var(--text-3);
  display:inline-block;
  transition:color var(--t-mid) var(--ease-soft),transform var(--t-mid) var(--ease-out);
}
.wordmark:hover .bracket{color:var(--accent);}
.wordmark:hover .bracket:first-of-type{transform:translateX(-2px);}
.wordmark:hover .bracket:last-of-type{transform:translateX(2px);}

.nav-links{display:flex;gap:4px;margin-inline-start:auto;}
.nav-links a{
  position:relative;
  font-size:14px;color:var(--text-3);text-decoration:none;
  padding:6px 10px;border-radius:var(--radius-sm);
  transition:color var(--t-fast) var(--ease-soft);
}
.nav-links a:hover{color:var(--text);}

/* An underline that grows out of the centre on hover, and stays put while
   that section is the one being read. Same mark for both states, so hovering
   a link is a preview of what "you are here" looks like.

   It is drawn under the text rather than under the padding box — an underline
   wider than the word it belongs to reads as a button, not a link. */
.nav-links a::after{
  content:'';position:absolute;
  bottom:2px;left:10px;right:10px;height:1px;
  background:currentColor;
  transform:scaleX(0);
  transition:transform var(--t-mid) var(--ease-out),background-color var(--t-fast) var(--ease-soft);
}
.nav-links a:hover::after{transform:scaleX(1);}

/* The current section's link is held at full strength with its underline
   drawn in the accent — the only place the accent appears in the header. */
.nav-links a.current{color:var(--text);}
.nav-links a.current::after{transform:scaleX(1);background:var(--accent);}

.head-actions{display:flex;align-items:center;gap:12px;}

.status{
  display:inline-flex;align-items:center;gap:7px;
  font-size:13px;color:var(--text-3);white-space:nowrap;
}
/* Not a blinking dot — that is movement in the corner of the screen the
   visitor has to actively ignore for the whole visit. This is a halo that
   breathes out and fades, four seconds apart, on a pseudo-element so the dot
   itself never moves. At 0.35 opacity over 4s it registers as "this is live"
   somewhere below conscious attention, which is the entire job. */
.status{position:relative;}
.status-dot{
  position:relative;
  width:6px;height:6px;border-radius:50%;
  background:var(--accent);flex-shrink:0;
}
.status-dot::after{
  content:'';position:absolute;inset:0;
  border-radius:50%;
  background:var(--accent);
  animation:halo 4s var(--ease-out) infinite;
}
@keyframes halo{
  0%{transform:scale(1);opacity:0.35;}
  /* The whole pulse happens in the first 45% of the cycle; the rest is the
     pause that keeps it from reading as a blink. */
  45%,100%{transform:scale(3);opacity:0;}
}

.icon-btn{
  display:flex;align-items:center;justify-content:center;
  width:32px;height:32px;padding:0;flex-shrink:0;
  background:transparent;border:1px solid var(--border);
  border-radius:var(--radius-sm);color:var(--text-3);cursor:pointer;
  transition:
    color var(--t-fast) var(--ease-soft),
    border-color var(--t-fast) var(--ease-soft),
    background-color var(--t-fast) var(--ease-soft),
    transform var(--t-fast) var(--ease-out);
}
.icon-btn:hover{color:var(--text);border-color:var(--border-strong);background:var(--surface);}
/* Scaling down on press is what makes a 32px square feel like a button
   rather than a picture of one. */
.icon-btn:active{transform:scale(0.92);}

/* The sun and moon rotate through the swap rather than cutting. Only the
   incoming icon is in the DOM at any moment (the two are display-toggled by
   the theme attribute), so this is an entrance, not a cross-fade. */
.icon-sun,.icon-moon{animation:icon-turn 0.4s var(--ease-out);}
@keyframes icon-turn{
  from{transform:rotate(-70deg) scale(0.7);opacity:0;}
  to{transform:rotate(0) scale(1);opacity:1;}
}

@media (prefers-reduced-motion: reduce){
  .status-dot::after{display:none;}
}

/* data-theme lives on <html>, outside this component, so the ancestor half of
   the selector needs :global() to survive Astro's style scoping. */
.icon-sun,.icon-moon{display:none;}
:global(:root:not([data-theme="light"])) .icon-sun{display:block;}
:global(:root[data-theme="light"]) .icon-moon{display:block;}

/* ─── Hamburger ──────────────────────────────────────────────── */
.hamburger{display:none;flex-direction:column;gap:5px;}
.hamburger span{
  display:block;width:16px;height:1.5px;border-radius:2px;
  background:currentColor;transition:transform var(--t-mid) var(--ease-out);
}
.hamburger.open span:nth-child(1){transform:translateY(3.25px) rotate(45deg);}
.hamburger.open span:nth-child(2){transform:translateY(-3.25px) rotate(-45deg);}

.mobile-menu{
  position:fixed;top:64px;inset-inline:0;z-index:99;
  background:var(--bg);border-bottom:1px solid var(--border);
  box-shadow:var(--shadow);
  padding:8px 20px 20px;
  flex-direction:column;
}
.mobile-menu:not([hidden]){display:flex;animation:menu-drop 0.26s var(--ease-out);}
@keyframes menu-drop{
  from{opacity:0;transform:translateY(-8px);}
  to{opacity:1;transform:none;}
}

.mobile-menu a{
  color:var(--text);text-decoration:none;font-size:16px;
  padding:14px 0;border-bottom:1px solid var(--border);
  transition:padding-inline-start var(--t-mid) var(--ease-out),color var(--t-fast) var(--ease-soft);
  /* Each link deals in after the panel, 40ms apart. The panel opening and
     the links arriving as one block is the difference between a menu that
     drops and a menu that unfolds. */
  animation:menu-item 0.4s var(--ease-out) backwards;
}
.mobile-menu a:nth-child(1){animation-delay:0.04s;}
.mobile-menu a:nth-child(2){animation-delay:0.08s;}
.mobile-menu a:nth-child(3){animation-delay:0.12s;}
.mobile-menu a:nth-child(4){animation-delay:0.16s;}
.mobile-menu a:nth-child(5){animation-delay:0.20s;}
.mobile-menu a:nth-child(6){animation-delay:0.24s;}
@keyframes menu-item{
  from{opacity:0;transform:translateY(-6px);}
  to{opacity:1;transform:none;}
}
/* Touch has no hover, so this is really the :active state — the row gives
   way under a finger. */
.mobile-menu a:active{padding-inline-start:8px;color:var(--accent);}
.menu-status{
  display:inline-flex;align-items:center;gap:8px;
  font-size:13px;color:var(--text-3);padding-top:16px;
}

/* Six links plus the availability line overflow the bar below ~940px. The two
   journey links give way first, so the four original links keep the bar
   exactly as it is at these widths; both sections stay in the mobile menu. */
@media(max-width:940px){
  .nav-extra{display:none;}
}
@media(max-width:780px){
  .status{display:none;}
}
@media(max-width:640px){
  .head-inner{padding:0 20px;height:60px;gap:12px;}
  .nav-links{display:none;}
  .hamburger{display:flex;}
  .mobile-menu{top:60px;}
}
</style>

<script>
  /* ── Theme toggle ──
     The initial theme is already on <html> (set pre-paint in Layout.astro);
     this only handles the switch, persists the choice, and keeps the label
     and the browser chrome colour in sync. */
  const themeBtn = document.getElementById('themeToggle');
  const root = document.documentElement;

  /* Both labels are rendered per locale into data- attributes, so the button
     describes itself in the page's own language instead of always announcing
     in English. */
  const describeTheme = (theme: string) => {
    if (!themeBtn) return;
    const label = theme === 'light'
      ? themeBtn.dataset.labelDark
      : themeBtn.dataset.labelLight;
    if (!label) return;
    themeBtn.setAttribute('aria-label', label);
    themeBtn.setAttribute('title', label);
  };

  describeTheme(root.getAttribute('data-theme') || 'dark');

  themeBtn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';

    // Fade the swap instead of snapping it — the class comes straight back off
    // so these transitions never apply during normal scrolling or hover.
    root.classList.add('theme-transition');
    window.setTimeout(() => root.classList.remove('theme-transition'), 250);

    root.setAttribute('data-theme', next);
    describeTheme(next);

    const meta = document.getElementById('themeColor');
    if (meta) meta.setAttribute('content', next === 'light' ? '#fbfbfb' : '#0f0f0f');

    // localStorage throws in private/blocked-cookie contexts; the toggle should
    // still work for this page view even when the choice can't be remembered.
    try { localStorage.setItem('theme', next); } catch { /* not persisted */ }
  });

  const ham = document.getElementById('ham');
  const menu = document.getElementById('mobileMenu');

  if (ham && menu) {
    const setOpen = (open: boolean) => {
      ham.classList.toggle('open', open);
      menu.hidden = !open;
      ham.setAttribute('aria-expanded', String(open));
      // Lock background scroll while the menu covers the page.
      document.body.style.overflow = open ? 'hidden' : '';
    };

    // `hidden` is typed as boolean | "until-found", so compare rather than
    // pass it straight through.
    ham.addEventListener('click', () => setOpen(menu.hidden !== false));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        ham.focus();
      }
    });

    menu.querySelectorAll('.menu-link').forEach(link => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>
