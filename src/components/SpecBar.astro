---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();
---
<section class="spec">
  <!-- reveal-group, so the three columns arrive left to right rather than
       all at once — the order is the point, and 55ms apart is enough to
       read as an order without anyone noticing they waited. -->
  <ul class="spec-list reveal-group">
    <li>
      <h2>{t.spec.webLabel}</h2>
      <p dir="ltr">{t.spec.webSub}</p>
    </li>
    <li>
      <h2>{t.spec.flutterLabel}</h2>
      <p dir="ltr">{t.spec.flutterSub}</p>
    </li>
    <li>
      <h2>{t.spec.backendLabel}</h2>
      <p dir="ltr">{t.spec.backendSub}</p>
    </li>
  </ul>
</section>

<style>
/* ─── What I do ──────────────────────────────────────────────────
   Three columns of plain text directly under the hero: the shortest possible
   answer to "what can he actually build". No icons, no boxes, no coloured
   glyph per column — the three headings and the space between them are the
   whole structure.

   Tighter vertical padding than a normal section on purpose: this reads as
   the second half of the hero, not as a section of its own. */
.spec{padding-top:44px;padding-bottom:44px;}

.spec-list{
  list-style:none;
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:32px;
}
/* Each column is its own hover target. There is no border and no background
   to change, so the whole response is a 6px accent rule that draws itself
   above the heading and the sub-line coming up to full strength — the
   column acknowledges the pointer without becoming a card. */
.spec-list li{
  position:relative;
  padding-top:14px;
}
.spec-list li::before{
  content:'';position:absolute;top:0;inset-inline-start:0;
  width:24px;height:1px;background:var(--border-strong);
  transition:width var(--t-mid) var(--ease-out),background-color var(--t-mid) var(--ease-soft);
}
.spec-list li:hover::before{width:42px;background:var(--accent);}

/* Headings, not just bold text: these are the site's three subject areas, so
   they belong in the document outline. Sized as small print all the same. */
.spec-list h2{
  font-family:var(--font-sans);font-size:15px;font-weight:600;
  color:var(--text);letter-spacing:0;
}
.spec-list p{
  font-family:var(--font-mono);font-size:12.5px;
  color:var(--text-3);line-height:1.6;margin-top:6px;
  transition:color var(--t-mid) var(--ease-soft);
}
.spec-list li:hover p{color:var(--text-2);}

@media(max-width:640px){
  .spec{padding-top:32px;padding-bottom:32px;}
  .spec-list{grid-template-columns:1fr;gap:20px;}
}
</style>
