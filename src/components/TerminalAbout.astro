---
---
<section class="terminal-section" id="about">
  <div class="sec-header reveal" style="text-align:center;">
    <div class="sec-tag" style="text-align:center;">// about</div>
    <h2 class="sec-title">Who am I?</h2>
  </div>
  <div class="terminal reveal">
    <div class="terminal-bar">
      <div class="t-dot t-red"></div>
      <div class="t-dot t-yellow"></div>
      <div class="t-dot t-green"></div>
      <div class="t-title">~ about.json</div>
    </div>
    <div class="terminal-body">
      <div><span class="t-prompt">❯ </span><span class="t-cmd">cat about.json</span></div>
      <div style="margin-top:14px;">&#123;</div>
      <div>&nbsp;&nbsp;<span class="t-key">"name"</span>: <span class="t-str">"Taha Mahmoud"</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"age"</span>: <span class="t-num">19</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"role"</span>: <span class="t-str">"Web &amp; Flutter Developer"</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"university"</span>: <span class="t-str">"AITU — Assiut, Egypt"</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"currently_building"</span>: <span class="t-str">"BaladUp — Community Flutter App"</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"web_stack"</span>: [<span class="t-str">"Angular"</span>, <span class="t-str">"TypeScript"</span>, <span class="t-str">"Supabase"</span>],</div>
      <div>&nbsp;&nbsp;<span class="t-key">"mobile_stack"</span>: [<span class="t-str">"Flutter"</span>, <span class="t-str">"Dart"</span>, <span class="t-str">"Supabase"</span>],</div>
      <div>&nbsp;&nbsp;<span class="t-key">"interests"</span>: [<span class="t-str">"algorithms"</span>, <span class="t-str">"automation"</span>, <span class="t-str">"content creation"</span>],</div>
      <div>&nbsp;&nbsp;<span class="t-key">"open_to_work"</span>: <span class="t-num" style="color:var(--green)">true</span>,</div>
      <div>&nbsp;&nbsp;<span class="t-key">"email"</span>: <span class="t-str">"iam.tahamahmoud@gmail.com"</span></div>
      <div>&#125;</div>
      <div style="margin-top:14px;"><span class="t-prompt">❯ </span><span class="t-comment"># Always learning, always shipping <i class='bx bx-rocket'></i></span></div>
    </div>
  </div>

  <div class="contrib-wrap">
    <div class="contrib-label reveal">// github activity</div>
    <div class="contrib-grid reveal" id="contribGrid"></div>
    <div class="contrib-legend reveal">
      <span>Less</span>
      <div class="legend-cell c0"></div>
      <div class="legend-cell c1"></div>
      <div class="legend-cell c2"></div>
      <div class="legend-cell c3"></div>
      <div class="legend-cell c4"></div>
      <span>More</span>
    </div>
  </div>
</section>

<style>
/* ─── Terminal / About ───────────────────────────────────────── */
.terminal-section{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.terminal{
  background:var(--bg);border:1px solid var(--border);border-radius:12px;
  overflow:hidden;max-width:720px;margin:0 auto;
  box-shadow:0 8px 48px rgba(0,0,0,0.4);
}
.terminal-bar{
  background:var(--bg3);padding:12px 16px;
  display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border);
}
.t-dot{width:12px;height:12px;border-radius:50%;}
.t-red{background:#f85149;}.t-yellow{background:#e3b341;}.t-green{background:#3fb950;}
.t-title{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);margin:0 auto;}
.terminal-body{padding:28px;font-family:'JetBrains Mono',monospace;font-size:13px;line-height:2;}
.t-prompt{color:var(--green);}.t-cmd{color:var(--white);}
.t-comment{color:var(--muted);}.t-key{color:var(--cyan);}
.t-val{color:var(--orange);}.t-str{color:var(--purple);}.t-num{color:var(--green);}

/* ─── Contributions ──────────────────────────────────────────── */
.contrib-wrap{margin-top:52px;max-width:720px;margin-left:auto;margin-right:auto;}
.contrib-label{text-align:center;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:3px;color:var(--green);text-transform:uppercase;margin-bottom:16px;}
.contrib-grid{display:grid;grid-template-columns:repeat(52,1fr);gap:3px;}
.contrib-cell{aspect-ratio:1;border-radius:2px;transition:transform 0.15s;}
.contrib-cell:hover{transform:scale(1.5);z-index:2;position:relative;}
.c0{background:#161b22;}.c1{background:#0e4429;}.c2{background:#006d32;}
.c3{background:#26a641;}.c4{background:#39d353;}
.contrib-legend{display:flex;align-items:center;gap:6px;justify-content:center;margin-top:10px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted);}
.legend-cell{width:11px;height:11px;border-radius:2px;}

@media(max-width:640px){
  .contrib-grid{grid-template-columns:repeat(26,1fr);}
}
</style>

<script>
  const cg = document.getElementById('contribGrid');
  if (cg && !cg.dataset.initialized) {
    cg.dataset.initialized = 'true';
    cg.innerHTML = '';
    
    type Point = { x: number; y: number };

    let W = window.innerWidth <= 640 ? 26 : 52;
    let H = 364 / W;
    const cells: HTMLDivElement[] = [];
    
    for (let i = 0; i < 364; i++) {
      const d = document.createElement('div');
      const r = Math.random();
      const type = r < 0.42 ? 0 : r < 0.6 ? 1 : r < 0.75 ? 2 : r < 0.9 ? 3 : 4;
      d.className = 'contrib-cell c' + type;
      d.dataset.type = type.toString();
      cg.appendChild(d);
      cells.push(d);
    }

    let snake: Point[] = [{x: 2, y: 0}, {x: 1, y: 0}, {x: 0, y: 0}];

    function getIndex(x: number, y: number) { return y * W + x; }
    
    function draw() {
      cells.forEach(c => {
        c.style.background = ''; 
        c.style.transform = ''; 
        c.style.zIndex = '';
        c.style.borderRadius = '';
      });
      
      snake.forEach((p, i) => {
        const el = cells[getIndex(p.x, p.y)];
        if(!el) return;
        if (i === 0) {
          el.style.background = 'var(--cyan)';
          el.style.transform = 'scale(1.25)';
          el.style.zIndex = '10';
          el.style.borderRadius = '4px';
        } else {
          el.style.background = 'var(--purple)';
          el.style.transform = 'scale(1.15)';
          el.style.zIndex = '9';
          el.style.borderRadius = '3px';
        }
      });
    }

    function getNeighbors(x: number, y: number): Point[] {
      const n: Point[] = [];
      if (x > 0) n.push({x: x-1, y});
      if (x < W-1) n.push({x: x+1, y});
      if (y > 0) n.push({x, y: y-1});
      if (y < H-1) n.push({x, y: y+1});
      return n;
    }

    function getNextMove(): Point | null {
      const startIdx = getIndex(snake[0].x, snake[0].y);
      const q: Point[][] = [[snake[0]]];
      const visited = new Set([startIdx]);

      for(let i = 1; i < snake.length - 1; i++) {
        visited.add(getIndex(snake[i].x, snake[i].y));
      }

      let backupMove: Point | null = null;

      while (q.length > 0) {
        const path = q.shift();
        if (!path) break;
        const head = path[path.length - 1];
        
        if (path.length > 1 && !backupMove) {
            backupMove = path[1];
        }

        const el = cells[getIndex(head.x, head.y)];
        if (el && el.dataset.type !== '0' && path.length > 1) {
          return path[1];
        }
        
        const neighbors = getNeighbors(head.x, head.y);
        neighbors.sort(() => Math.random() - 0.5);

        for (const np of neighbors) {
          const nIdx = getIndex(np.x, np.y);
          if (!visited.has(nIdx)) {
            visited.add(nIdx);
            q.push([...path, np]);
          }
        }
      }
      
      if (backupMove) return backupMove;

      for (const np of getNeighbors(snake[0].x, snake[0].y)) {
        if (!snake.some((s, i) => i !== snake.length - 1 && s.x === np.x && s.y === np.y)) {
          return np;
        }
      }
      return null;
    }

    let isPlaying = false;
    let timer: ReturnType<typeof setTimeout> | null = null;

    function step() {
      if (!isPlaying) return;
      
      const nextHead = getNextMove();
      if (!nextHead) {
        timer = setTimeout(() => {
          cells.forEach(el => {
            const r = Math.random();
            const type = r < 0.42 ? 0 : r < 0.6 ? 1 : r < 0.75 ? 2 : r < 0.9 ? 3 : 4;
            el.className = 'contrib-cell c' + type;
            el.dataset.type = type.toString();
          });
          snake = [{x: 2, y: 0}, {x: 1, y: 0}, {x: 0, y: 0}];
          step();
        }, 2000);
        return;
      }
      
      snake.unshift(nextHead);
      const el = cells[getIndex(nextHead.x, nextHead.y)];
      
      let ate = false;
      if (el && el.dataset.type !== '0') {
        ate = true;
        el.dataset.type = '0';
        el.className = 'contrib-cell c0';
      }
      
      if (!ate || snake.length > 15) {
        snake.pop();
      }
      
      draw();
      timer = setTimeout(step, 80);
    }
    
    window.addEventListener('resize', () => {
      const newW = window.innerWidth <= 640 ? 26 : 52;
      if (newW !== W) {
        W = newW;
        H = 364 / W;
        snake = [{x: 2, y: 0}, {x: 1, y: 0}, {x: 0, y: 0}];
      }
    });

    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        if (!isPlaying) {
          isPlaying = true;
          step();
        }
      } else {
        isPlaying = false;
        if(timer) clearTimeout(timer);
      }
    });
    observer.observe(cg);
  }
</script>
