---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)();
const certs = t.certsSec;
---
<section class="certs" id="certifications">
  <div class="sec-header reveal">
    <div class="sec-tag">{certs.tag}</div>
    <h2 class="sec-title">{certs.title}</h2>
    <p class="sec-sub">{certs.sub}</p>
  </div>

  <ul class="cert-grid">
    {certs.featured.map(cert => (
      <li class="cert reveal">
        <!--
          A real link to the file, not a bare button: the lightbox below
          upgrades it on click, and without JS the certificate still opens.
        -->
        <a
          class="cert-shot"
          href={cert.img}
          target="_blank"
          rel="noopener"
          aria-label={`${certs.viewLabel} — ${cert.title}`}
          data-caption={`${cert.title} · ${cert.issuer}`}
          data-alt={`${certs.imgAlt} ${cert.title}`}
        >
          <img src={cert.img} alt={`${certs.imgAlt} ${cert.title}`} loading="lazy" decoding="async" />
        </a>
        <h3 class="cert-title">{cert.title}</h3>
        <p class="cert-issuer">
          {cert.issuer}{cert.hours && <span> · {cert.hours}</span>}
        </p>
      </li>
    ))}
  </ul>

  <div class="cert-more-wrap reveal">
    <!--
      Rendered expanded, with the toggle hidden: the script below unhides the
      button and collapses the panel on load. Done the other way round, a
      visitor whose JS never arrives would get a dead button and four
      permanently invisible entries.
    -->
    <button
      class="btn btn-ghost cert-toggle"
      id="certToggle"
      type="button"
      hidden
      aria-expanded="true"
      aria-controls="certMore"
      data-label-all={certs.showAll}
      data-label-less={certs.showLess}
    >
      <span class="cert-toggle-txt">{certs.showLess}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </button>

    <div class="cert-more" id="certMore">
      <h3 class="cert-more-title">{certs.moreTitle}</h3>
      <ul class="cert-rows">
        {certs.more.map(item => (
          <li class="cert-row">
            <a
              class="cert-shot cert-row-shot"
              href={item.img}
              target="_blank"
              rel="noopener"
              aria-label={`${certs.viewLabel} — ${item.title}`}
              data-caption={item.issuer ? `${item.title} · ${item.issuer}` : item.title}
              data-alt={`${certs.imgAlt} ${item.title}`}
            >
              <img src={item.img} alt={`${certs.imgAlt} ${item.title}`} loading="lazy" decoding="async" />
            </a>
            <div class="cert-row-body">
              <h4 class="cert-row-title">{item.title}</h4>
              {item.issuer && (
                <p class="cert-row-issuer">
                  {item.issuer}{item.hours && <span> · {item.hours}</span>}
                </p>
              )}
              {!item.issuer && item.hours && <p class="cert-row-issuer">{item.hours}</p>}
              {item.note && <p class="cert-row-note">{item.note}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <dialog class="lightbox" id="certLightbox" aria-labelledby="certLightboxCap">
    <div class="lightbox-inner">
      <button class="lightbox-close" id="certLightboxClose" type="button" aria-label={certs.closeLabel}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <img class="lightbox-img" id="certLightboxImg" alt="" />
      <p class="lightbox-cap" id="certLightboxCap"></p>
    </div>
  </dialog>
</section>

<style>
/* ─── Certifications ─────────────────────────────────────────────
   The scans are the point: a certificate you can open and read is worth more
   than any badge drawn around its title. So the image leads, and everything
   that used to frame it — a coloured hairline along each card's top edge, a
   tinted icon tile, a pill for the hour count, dashed borders on the second
   tier — is gone. What is left is a thumbnail, a title and an issuer. */
.cert-grid{
  list-style:none;
  display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
  gap:28px 24px;
}

/* Fixed 16/10 box rather than each image's own ratio: the scans run from
   portrait to wide landscape, and a grid where every thumbnail sets its own
   height reads as broken rather than varied. The crop is anchored to the top
   because that is where a certificate puts its issuer and its title. */
.cert-shot{
  display:block;position:relative;
  aspect-ratio:16/10;
  background:var(--surface-2);
  border:1px solid var(--border);border-radius:var(--radius);
  overflow:hidden;cursor:zoom-in;
  transition:border-color 0.18s;
}
.cert-shot img{
  width:100%;height:100%;
  object-fit:cover;object-position:top center;
}
.cert-shot:hover{border-color:var(--border-strong);}

.cert-title{
  font-family:var(--font-sans);font-size:15px;font-weight:600;
  letter-spacing:0;line-height:1.45;margin-top:12px;
}
.cert-issuer{font-size:13.5px;color:var(--text-3);line-height:1.6;margin-top:3px;}
/* Course and issuer names keep their official Latin spelling in the Arabic
   locale, so isolate them from the surrounding RTL run. */
.cert-title,.cert-issuer,.cert-row-title,.cert-row-issuer{unicode-bidi:isolate;}

/* ─── Second tier ────────────────────────────────────────────── */
.cert-more-wrap{margin-top:36px;}
.cert-toggle{font-size:14px;padding:9px 16px;}
.cert-toggle svg{transition:transform 0.2s;}
.cert-toggle[aria-expanded="true"] svg{transform:rotate(180deg);}

.cert-more{margin-top:28px;}
.cert-more-title{font-size:18px;margin-bottom:4px;}

.cert-rows{list-style:none;}
.cert-row{
  display:flex;align-items:flex-start;gap:16px;
  padding:16px 0;border-bottom:1px solid var(--border);
}
.cert-row:first-child{border-top:1px solid var(--border);}
.cert-row-shot{width:88px;flex-shrink:0;aspect-ratio:4/3;border-radius:var(--radius-sm);}
.cert-row-body{flex:1;min-width:0;}
.cert-row-title{font-family:var(--font-sans);font-size:15px;font-weight:600;letter-spacing:0;line-height:1.45;}
.cert-row-issuer{font-size:13px;color:var(--text-3);margin-top:3px;}
.cert-row-note{font-size:14px;color:var(--text-2);margin-top:8px;max-width:var(--measure);}

/* ─── Lightbox ───────────────────────────────────────────────────
   A native <dialog>, so focus trapping and Escape-to-close come from the
   browser rather than from hand-written key handling. It fills the viewport
   so a click anywhere around the image lands on the dialog itself, which is
   what closes it. */
.lightbox{
  width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;
  margin:0;padding:0;border:0;background:transparent;
}
.lightbox[open]{display:grid;place-items:center;}
.lightbox::backdrop{background:rgba(15,15,15,0.9);}

.lightbox-inner{
  position:relative;
  display:flex;flex-direction:column;align-items:center;gap:12px;
  padding:16px;max-width:96vw;
}
.lightbox-img{
  max-width:min(96vw,1100px);max-height:78dvh;
  width:auto;height:auto;
  border-radius:var(--radius);
  background:var(--surface);
}
/* Fixed light values, not --text: the backdrop stays dark in both themes, so
   the theme token would turn this near-black and unreadable in light mode. */
.lightbox-cap{
  font-size:13px;line-height:1.6;
  color:#fbfbfb;text-align:center;max-width:70ch;unicode-bidi:isolate;
}
.lightbox-close{
  position:absolute;top:-2px;inset-inline-end:-2px;z-index:1;
  width:36px;height:36px;border-radius:50%;
  display:grid;place-items:center;cursor:pointer;
  color:#fbfbfb;background:rgba(15,15,15,0.7);
  border:1px solid rgba(251,251,251,0.25);
  transition:background 0.18s,border-color 0.18s;
}
.lightbox-close:hover{background:rgba(15,15,15,0.95);border-color:rgba(251,251,251,0.5);}

@media(max-width:640px){
  .cert-grid{grid-template-columns:1fr 1fr;gap:20px 16px;}
  .cert-row-shot{width:72px;}
  .lightbox-img{max-height:70dvh;}
}
@media(max-width:400px){
  .cert-grid{grid-template-columns:1fr;}
}
</style>

<script>
  /* Collapse the secondary tier and hand the toggle over to the visitor. Both
     labels come from data- attributes so the button speaks the page's own
     language instead of always announcing in English (same approach as the
     theme toggle in Navbar.astro). */
  const certToggle = document.getElementById('certToggle') as HTMLButtonElement | null;
  const certMore = document.getElementById('certMore');

  if (certToggle && certMore) {
    const certLabel = certToggle.querySelector('.cert-toggle-txt');

    const setCertsOpen = (open: boolean) => {
      certMore.hidden = !open;
      certToggle.setAttribute('aria-expanded', String(open));
      const label = open ? certToggle.dataset.labelLess : certToggle.dataset.labelAll;
      if (certLabel && label) certLabel.textContent = label;
    };

    certToggle.hidden = false;
    setCertsOpen(false);

    certToggle.addEventListener('click', () => {
      setCertsOpen(certToggle.getAttribute('aria-expanded') !== 'true');
    });
  }

  /* Upgrade the certificate links into a lightbox — but only where <dialog>
     is actually usable. Everywhere else the links keep doing what they already
     do and open the image file directly. */
  const lightbox = document.getElementById('certLightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('certLightboxImg') as HTMLImageElement | null;
  const lbCap = document.getElementById('certLightboxCap');
  const lbClose = document.getElementById('certLightboxClose');

  if (lightbox && lbImg && lbCap && typeof lightbox.showModal === 'function') {
    /* The page behind a modal dialog still scrolls, so it gets locked while
       the lightbox is open. Releasing it only on the dialog's `close` event
       would be neater, but if that event ever fails to arrive the visitor is
       left on a page that cannot scroll at all — so every path that closes
       the lightbox releases the lock itself, and the event is a backstop. */
    const unlock = () => { document.body.style.overflow = ''; };
    const dismiss = () => { lightbox.close(); unlock(); };

    document.querySelectorAll<HTMLAnchorElement>('.cert-shot').forEach(shot => {
      shot.addEventListener('click', (e) => {
        // Leave ctrl/cmd/shift-click alone so "open in a new tab" still works.
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        lbImg.src = shot.href;
        lbImg.alt = shot.dataset.alt || '';
        lbCap.textContent = shot.dataset.caption || '';
        lightbox.showModal();
        document.body.style.overflow = 'hidden';
      });
    });

    lbClose?.addEventListener('click', dismiss);
    // A click that lands on the dialog element itself is a click on the area
    // around the image, i.e. the backdrop.
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) dismiss();
    });
    // The browser's own Escape handling, plus anything else that closes it.
    lightbox.addEventListener('cancel', unlock);
    lightbox.addEventListener('close', unlock);
  }
</script>
